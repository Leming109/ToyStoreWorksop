@model ToyStoreBE.Models.Order

@{
    ViewBag.Title = "Chi tiết hóa đơn";
    Layout = "~/Areas/Admin/Views/Shared/_AdminsLayout.cshtml";
}

<style>
    .invoice-page {
        padding: 20px 25px;
        color: #1e293b;
    }

    .invoice-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        max-width: 950px;
        margin: 0 auto 20px;
    }

    .invoice-action-right {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .invoice-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 17px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none !important;
        border: 1px solid transparent;
        cursor: pointer;
        transition: .2s;
    }

    .invoice-btn-back {
        color: #475569;
        background: #fff;
        border-color: #cbd5e1;
    }

        .invoice-btn-back:hover {
            color: #334155;
            background: #f1f5f9;
        }

    .invoice-btn-print {
        color: #fff;
        background: #e74c3c;
        border-color: #e74c3c;
    }

        .invoice-btn-print:hover {
            color: #fff;
            background: #c0392b;
        }

    .invoice-card {
        position: relative;
        max-width: 950px;
        margin: 0 auto;
        overflow: hidden;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 5px 20px rgba(15, 23, 42, .06);
    }

    .invoice-top-line {
        height: 7px;
        background: #e74c3c;
    }

    .invoice-content {
        padding: 35px 40px;
    }

    .invoice-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        flex-wrap: wrap;
        gap: 20px;
        padding-bottom: 25px;
        border-bottom: 2px solid #f1f5f9;
    }

    .invoice-brand h2 {
        margin: 0 0 8px;
        color: #333;
        font-size: 30px;
        font-weight: 800;
    }

        .invoice-brand h2 span {
            color: #e74c3c;
        }

    .invoice-brand p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
    }

    .invoice-title {
        text-align: right;
    }

        .invoice-title h3 {
            margin: 0 0 8px;
            color: #c0392b;
            font-size: 25px;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .invoice-title p {
            margin: 4px 0;
            color: #64748b;
            font-size: 13px;
        }

    .invoice-section {
        margin-top: 28px;
    }

    .invoice-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 16px;
        padding-bottom: 10px;
        color: #c0392b;
        font-size: 16px;
        font-weight: 700;
        border-bottom: 1px solid #fee2e2;
    }

    .invoice-customer-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px 35px;
    }

    .invoice-info-item label {
        display: block;
        margin-bottom: 6px;
        color: #94a3b8;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .invoice-info-item p {
        margin: 0;
        color: #334155;
        font-size: 14px;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    .invoice-product-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

        .invoice-product-table thead {
            background: #fff1ef;
        }

        .invoice-product-table th {
            padding: 13px 12px;
            color: #9f3027;
            font-size: 12px;
            font-weight: 700;
            text-align: left;
            text-transform: uppercase;
            border-bottom: 1px solid #fecaca;
        }

        .invoice-product-table td {
            padding: 15px 12px;
            color: #475569;
            font-size: 13px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

    .invoice-product-name {
        color: #334155;
        font-size: 14px;
        font-weight: 700;
    }

    .invoice-product-note {
        margin-top: 5px;
        color: #94a3b8;
        font-size: 12px;
    }

    .invoice-money {
        white-space: nowrap;
        font-weight: 600;
    }

    .invoice-total {
        display: flex;
        justify-content: flex-end;
        margin-top: 20px;
    }

    .invoice-total-box {
        width: 100%;
        max-width: 350px;
    }

    .invoice-total-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 10px 0;
        color: #64748b;
        font-size: 14px;
    }

    .invoice-total-final {
        margin-top: 5px;
        padding-top: 16px;
        color: #c0392b;
        font-size: 18px;
        font-weight: 800;
        border-top: 2px solid #fecaca;
    }

    .invoice-payment {
        display: inline-block;
        padding: 6px 12px;
        color: #c0392b;
        background: #fff1ef;
        border: 1px solid #fecaca;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
    }

    .invoice-thanks {
        margin-top: 35px;
        padding-top: 22px;
        color: #64748b;
        text-align: center;
        border-top: 1px dashed #cbd5e1;
    }

        .invoice-thanks h4 {
            margin: 0 0 8px;
            color: #e74c3c;
            font-size: 18px;
            font-weight: 700;
        }

        .invoice-thanks p {
            margin: 0;
            font-size: 13px;
        }

    .invoice-empty {
        padding: 25px;
        color: #94a3b8;
        text-align: center;
    }

    @@media (max-width: 650px) {
        .invoice-page {
            padding: 15px 5px;
        }

        .invoice-content {
            padding: 22px 15px;
        }

        .invoice-brand h2 {
            font-size: 25px;
        }

        .invoice-title {
            text-align: left;
        }

        .invoice-customer-grid {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .invoice-product-table th,
        .invoice-product-table td {
            padding: 10px 7px;
            font-size: 11px;
        }

        .invoice-product-name {
            font-size: 12px;
        }
    }

    /* CHẾ ĐỘ IN HÓA ĐƠN */
    @@page {
        size: A4;
        margin: 15mm;
    }

    @@media print {

        body {
            background: #fff !important;
        }

        aside,
        .admin-content footer,
        .invoice-actions {
            display: none !important;
        }

        .admin-content {
            width: 100% !important;
            min-height: auto !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .page-content {
            width: 100% !important;
        }

        .invoice-page {
            padding: 0 !important;
        }

        .invoice-card {
            max-width: none !important;
            border: none !important;
            border-radius: 0 !important;
            box-shadow: none !important;
        }

        .invoice-content {
            padding: 10px 0 !important;
        }

        .invoice-top-line {
            background: #e74c3c !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .invoice-product-table thead,
        .invoice-payment {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .invoice-product-table tr {
            page-break-inside: avoid;
        }
    }
</style>

<div class="invoice-page">

    <!-- CÁC NÚT CHỨC NĂNG -->
    <div class="invoice-actions">

        @Html.ActionLink(
            "Quay lại danh sách",
            "Index",
            "Orders",
            new { area = "Admin" },
            new { @class = "invoice-btn invoice-btn-back" }
        )

        <div class="invoice-action-right">

            <button type="button"
                    class="invoice-btn invoice-btn-print"
                    onclick="window.print()">
                <i class="fa-solid fa-print"></i>
                In hóa đơn
            </button>

        </div>

    </div>

    <!-- HÓA ĐƠN -->
    <div class="invoice-card">

        <div class="invoice-top-line"></div>

        <div class="invoice-content">

            <!-- HEADER HÓA ĐƠN -->
            <div class="invoice-header">

                <div class="invoice-brand">
                    <h2>TOY<span>STORE</span></h2>

                    <p>Cửa hàng đồ chơi và mô hình</p>
                    <p>Cảm ơn bạn đã lựa chọn ToyStore.</p>
                </div>

                <div class="invoice-title">

                    <h3>HÓA ĐƠN</h3>

                    <p>
                        Mã đơn hàng:
                        <strong>#@Model.OrderID</strong>
                    </p>

                    <p>
                        Ngày đặt:
                        <strong>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</strong>
                    </p>

                </div>

            </div>

            <!-- THÔNG TIN KHÁCH HÀNG -->
            <div class="invoice-section">

                <div class="invoice-section-title">
                    <i class="fa-solid fa-user"></i>
                    THÔNG TIN KHÁCH HÀNG
                </div>

                <div class="invoice-customer-grid">

                    <div class="invoice-info-item">
                        <label>Họ và tên</label>
                        <p>
                            @(Model.Customer != null
                                ? Model.Customer.CustomerName
                                : "Không xác định")
                        </p>
                    </div>

                    <div class="invoice-info-item">
                        <label>Số điện thoại</label>
                        <p>
                            @(Model.Customer != null
                                ? Model.Customer.CustomerPhone
                                : "Không có thông tin")
                        </p>
                    </div>

                    <div class="invoice-info-item">
                        <label>Email</label>
                        <p>
                            @(Model.Customer != null
                                ? Model.Customer.CustomerEmail
                                : "Không có thông tin")
                        </p>
                    </div>

                    <div class="invoice-info-item">
                        <label>Địa chỉ khách hàng</label>
                        <p>
                            @(Model.Customer != null
                                ? Model.Customer.CustomerAddress
                                : "Không có thông tin")
                        </p>
                    </div>

                    <div class="invoice-info-item">
                        <label>Địa chỉ giao hàng</label>
                        <p>
                            @Model.AddressDelivery
                        </p>
                    </div>

                    <div class="invoice-info-item">
                        <label>Trạng thái / phương thức thanh toán</label>
                        <p>
                            <span class="invoice-payment">
                                @(string.IsNullOrWhiteSpace(Model.PaymentStatus)
                                    ? "Chưa cập nhật"
                                    : Model.PaymentStatus)
                            </span>
                        </p>
                    </div>

                </div>

            </div>

            <!-- DANH SÁCH SẢN PHẨM -->
            <div class="invoice-section">

                <div class="invoice-section-title">
                    <i class="fa-solid fa-box-open"></i>
                    DANH SÁCH SẢN PHẨM
                </div>

                <div class="table-responsive">

                    <table class="invoice-product-table">

                        <thead>
                            <tr>
                                <th style="width: 42%;">Sản phẩm</th>
                                <th style="width: 12%; text-align: center;">SL</th>
                                <th style="width: 22%; text-align: right;">Đơn giá</th>
                                <th style="width: 24%; text-align: right;">Thành tiền</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.OrderDetails != null &&
                                 Model.OrderDetails.Any())
                            {
                                foreach (var item in Model.OrderDetails)
                                {
                                    <tr>

                                        <td>
                                            <div class="invoice-product-name">
                                                @(item.Product != null
                                                    ? item.Product.ProductName
                                                    : "Sản phẩm không tồn tại")
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(item.Note))
                                            {
                                                <div class="invoice-product-note">
                                                    Ghi chú: @item.Note
                                                </div>
                                            }
                                        </td>

                                        <td style="text-align: center;">
                                            @item.Quantity
                                        </td>

                                        <td style="text-align: right;">
                                            <span class="invoice-money">
                                                @item.UnitPrice.ToString("N0") đ
                                            </span>
                                        </td>

                                        <td style="text-align: right;">
                                            <span class="invoice-money">
                                                @((item.UnitPrice * item.Quantity).ToString("N0")) đ
                                            </span>
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="invoice-empty">
                                        Đơn hàng chưa có sản phẩm chi tiết.
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

            <!-- TỔNG THANH TOÁN -->
            <div class="invoice-total">

                <div class="invoice-total-box">

                    <div class="invoice-total-row">
                        <span>Số lượng sản phẩm</span>

                        <strong>
                            @(Model.OrderDetails == null
                                ? 0
                                : Model.OrderDetails.Sum(d => d.Quantity))
                        </strong>
                    </div>

                    <div class="invoice-total-row invoice-total-final">
                        <span>TỔNG THANH TOÁN</span>

                        <span>
                            @Model.TotalAmount.ToString("N0") đ
                        </span>
                    </div>

                </div>

            </div>

            <!-- LỜI CẢM ƠN -->
            <div class="invoice-thanks">

                <h4>CẢM ƠN QUÝ KHÁCH!</h4>

                <p>
                    ToyStore rất hân hạnh được phục vụ quý khách.
                </p>

            </div>

        </div>

    </div>

</div>