
@model ToyStoreBE.Models.Order

@using System
@using System.Linq
@using System.Collections.Generic
@using System.Web.Mvc

@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminsLayout.cshtml";

    string currentStatus = string.IsNullOrWhiteSpace(Model.OrderStatus)
        ? "Chờ xác nhận"
        : Model.OrderStatus.Trim();

    var nextStatuses = ViewBag.NextStatuses as IEnumerable<SelectListItem>
        ?? Enumerable.Empty<SelectListItem>();

    string[] statusSteps =
    {
        "Chờ xác nhận",
        "Đã xác nhận",
        "Đang chuẩn bị hàng",
        "Đang giao hàng",
        "Đã giao hàng"
    };

    int currentStep = Array.IndexOf(statusSteps, currentStatus);

    string statusClass = "pending";
    string statusIcon = "fa-clock";

    switch (currentStatus)
    {
        case "Đã xác nhận":
            statusClass = "confirmed";
            statusIcon = "fa-circle-check";
            break;

        case "Đang chuẩn bị hàng":
            statusClass = "preparing";
            statusIcon = "fa-box";
            break;

        case "Đang giao hàng":
            statusClass = "shipping";
            statusIcon = "fa-truck";
            break;

        case "Đã giao hàng":
            statusClass = "delivered";
            statusIcon = "fa-check-double";
            break;

        case "Đã hủy":
            statusClass = "cancelled";
            statusIcon = "fa-ban";
            break;
    }
}

<style>
    .admin-order-detail-page {
        padding: 20px 15px;
    }

    /* TOOLBAR */
    .admin-order-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        max-width: 950px;
        margin: 0 auto 20px;
    }

    .admin-order-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none !important;
        cursor: pointer;
    }

    .admin-order-back {
        color: #475569;
        background: #fff;
        border: 1px solid #cbd5e1;
    }

        .admin-order-back:hover {
            color: #334155;
            background: #f1f5f9;
        }

    .admin-order-print {
        color: #fff;
        background: #e74c3c;
        border: 1px solid #e74c3c;
    }

        .admin-order-print:hover {
            color: #fff;
            background: #c0392b;
        }

    /* STATUS CARD */
    .order-status-management {
        max-width: 950px;
        margin: 0 auto 24px;
        padding: 25px;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 13px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, .04);
    }

    .status-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }

        .status-heading h3 {
            margin: 0;
            color: #1e293b;
            font-size: 19px;
            font-weight: 700;
        }

    .status-order-id {
        color: #c0392b;
        font-weight: 700;
    }

    .current-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 13px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-pending {
        color: #a16207;
        background: #fef9c3;
        border: 1px solid #fde68a;
    }

    .status-confirmed {
        color: #1d4ed8;
        background: #dbeafe;
        border: 1px solid #bfdbfe;
    }

    .status-preparing {
        color: #0369a1;
        background: #e0f2fe;
        border: 1px solid #bae6fd;
    }

    .status-shipping {
        color: #7e22ce;
        background: #f3e8ff;
        border: 1px solid #e9d5ff;
    }

    .status-delivered {
        color: #15803d;
        background: #dcfce7;
        border: 1px solid #bbf7d0;
    }

    .status-cancelled {
        color: #dc2626;
        background: #fef2f2;
        border: 1px solid #fecaca;
    }

    /* PROGRESS */
    .order-progress {
        display: flex;
        align-items: flex-start;
        margin: 35px 0;
    }

    .progress-step {
        position: relative;
        flex: 1;
        min-width: 0;
        text-align: center;
    }

        .progress-step:not(:last-child)::after {
            content: "";
            position: absolute;
            top: 15px;
            left: 60%;
            width: 80%;
            height: 3px;
            background: #e2e8f0;
            z-index: 0;
        }

        .progress-step.completed:not(:last-child)::after {
            background: #22c55e;
        }

    .progress-dot {
        position: relative;
        z-index: 1;
        width: 31px;
        height: 31px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 10px;
        border-radius: 50%;
        color: #94a3b8;
        background: #e2e8f0;
        font-size: 12px;
    }

    .progress-step.completed .progress-dot {
        color: #fff;
        background: #22c55e;
    }

    .progress-step.current .progress-dot {
        color: #fff;
        background: #e74c3c;
        box-shadow: 0 0 0 5px #fee2e2;
    }

    .progress-label {
        display: block;
        color: #94a3b8;
        font-size: 11px;
        font-weight: 600;
        line-height: 1.5;
    }

    .progress-step.completed .progress-label,
    .progress-step.current .progress-label {
        color: #334155;
    }

    /* UPDATE STATUS */
    .status-update-box {
        padding: 20px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
    }

        .status-update-box h4 {
            margin: 0 0 8px;
            color: #334155;
            font-size: 16px;
            font-weight: 700;
        }

    .status-update-description {
        margin-bottom: 17px;
        color: #64748b;
        font-size: 13px;
    }

    .status-update-form {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .status-select {
        flex: 1;
        min-width: 220px;
        height: 45px;
        padding: 8px 12px;
        color: #334155;
        background: #fff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        outline: none;
    }

        .status-select:focus {
            border-color: #e74c3c;
            box-shadow: 0 0 0 3px rgba(231, 76, 60, .12);
        }

    .btn-update-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 45px;
        padding: 10px 18px;
        color: #fff;
        background: #e74c3c;
        border: 1px solid #e74c3c;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: .2s;
    }

        .btn-update-status:hover {
            color: #fff;
            background: #c0392b;
            border-color: #c0392b;
        }

    /* TERMINAL MESSAGE */
    .status-terminal-message {
        padding: 15px;
        color: #64748b;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        font-size: 13px;
        line-height: 1.6;
    }

    .status-alert {
        max-width: 950px;
        margin: 0 auto 18px;
    }

    /* PRINT */
    @@media print {
        aside,
        .admin-content footer,
        .admin-order-toolbar,
        .order-status-management,
        .status-alert {
            display: none !important;
        }

        .admin-content {
            width: 100% !important;
            min-height: auto !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        .page-content {
            width: 100% !important;
        }

        .admin-order-detail-page {
            margin: 0 !important;
            padding: 0 !important;
        }

        .order-invoice-card {
            max-width: none !important;
            border: none !important;
            box-shadow: none !important;
        }
    }

    @@media(max-width: 650px) {
        .admin-order-detail-page {
            padding: 12px 5px;
        }

        .order-status-management {
            padding: 17px 12px;
        }

        .progress-label {
            font-size: 9px;
        }

        .status-update-form {
            flex-direction: column;
            align-items: stretch;
        }

        .btn-update-status {
            width: 100%;
        }
    }
</style>

<div class="admin-order-detail-page">

    <!-- TOOLBAR -->
    <div class="admin-order-toolbar">

        @Html.ActionLink(
                 "Quay lại danh sách",
                 "Index",
                 "Orders",
                 new { area = "Admin" },
                 new { @class = "admin-order-btn admin-order-back" }
             )

        <button type="button"
                class="admin-order-btn admin-order-print"
                onclick="window.print()">

            <i class="fa-solid fa-print"></i>
            In hóa đơn

        </button>

    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success status-alert">
            <i class="fa-solid fa-circle-check"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger status-alert">
            <i class="fa-solid fa-circle-exclamation"></i>
            @TempData["Error"]
        </div>
    }

    <!-- QUẢN LÝ TRẠNG THÁI -->
    <div class="order-status-management">

        <div class="status-heading">

            <h3>
                <i class="fa-solid fa-route" style="color:#e74c3c;"></i>
                Tiến trình đơn hàng
                <span class="status-order-id">#@Model.OrderID</span>
            </h3>

            <span class="current-status status-@statusClass">
                <i class="fa-solid @statusIcon"></i>
                @currentStatus
            </span>

        </div>

        @if (currentStatus == "Đã hủy")
        {
            <div class="status-terminal-message">
                <i class="fa-solid fa-ban"></i>
                Đơn hàng đã bị hủy và không thể tiếp tục xử lý.
            </div>
        }
        else if (currentStep >= 0)
        {
            <!-- THANH TIẾN TRÌNH -->
            <div class="order-progress">

                @for (int i = 0; i < statusSteps.Length; i++)
                {
                    bool completed = i < currentStep;
                    bool isCurrent = i == currentStep;

                    string stepClass = completed
                        ? "completed"
                        : isCurrent ? "current" : "";

                    <div class="progress-step @stepClass">

                        <div class="progress-dot">

                            @if (completed)
                            {
                                <i class="fa-solid fa-check"></i>
                            }
                            else
                            {
                                @(i + 1)
                            }

                        </div>

                        <span class="progress-label">
                            @statusSteps[i]
                        </span>

                    </div>
                }

            </div>
        }

        <!-- FORM CẬP NHẬT -->
        @if (nextStatuses.Any())
        {
            <div class="status-update-box">

                <h4>
                    <i class="fa-solid fa-pen-to-square"
                       style="color:#e74c3c;"></i>
                    Cập nhật trạng thái đơn hàng
                </h4>

                <p class="status-update-description">
                    Chọn trạng thái tiếp theo để cập nhật tiến trình xử lý đơn hàng.
                </p>

                @using (Html.BeginForm(
                    "UpdateStatus",
                    "Orders",
                    new { area = "Admin", id = Model.OrderID },
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="status-update-form">

                        @Html.DropDownList(
                                 "orderStatus",
                                 nextStatuses,
                                 "-- Chọn trạng thái tiếp theo --",
                                 new
                                 {
                                     @class = "status-select",
                                     required = "required"
                                 }
                             )

                        <button type="submit"
                                class="btn-update-status">

                            <i class="fa-solid fa-floppy-disk"></i>
                            Lưu trạng thái

                        </button>

                    </div>
                }

            </div>
        }
        else
        {
            if (currentStatus == "Đã giao hàng")
            {
                <div class="status-terminal-message">
                    <i class="fa-solid fa-circle-check"
                       style="color:#16a34a;"></i>

                    Đơn hàng đã hoàn tất. Không thể thay đổi trạng thái nữa.
                </div>
            }
            else if (currentStatus != "Đã hủy")
            {
                <div class="status-terminal-message">
                    Không tìm thấy trạng thái tiếp theo hợp lệ.
                    Vui lòng kiểm tra lại dữ liệu đơn hàng.
                </div>
            }
        }

    </div>

    <!-- HÓA ĐƠN -->
    @Html.Partial(
            "~/Views/Shared/_OrderInvoice.cshtml",
            Model
        )

</div>
