
@model IEnumerable<ToyStoreBE.Models.Order>

@using System
@using System.Linq

@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminsLayout.cshtml";

    int totalOrders = Model == null ? 0 : Model.Count();

    decimal totalOrderValue = Model == null
        ? 0m
        : Model.Sum(o => o.TotalAmount);
}

<style>
    .order-page {
        padding: 20px 25px;
        color: #1e293b;
    }

    /* HEADER */
    .order-header {
        margin-bottom: 25px;
    }

        .order-header h2 {
            margin: 0 0 8px;
            font-size: 28px;
            font-weight: 700;
            color: #1e293b;
        }

        .order-header p {
            margin: 0;
            color: #64748b;
            font-size: 14px;
        }

    /* ORDER CARD */
    .order-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, .04);
    }

    .order-card-top {
        padding: 16px 20px;
        background: #fff7f7;
        border-bottom: 1px solid #fee2e2;
    }

        .order-card-top h4 {
            margin: 0;
            color: #c0392b;
            font-size: 16px;
            font-weight: 700;
        }

    /* TABLE */
    .order-table {
        width: 100%;
        min-width: 1050px;
        margin: 0;
        border-collapse: collapse;
    }

        .order-table thead {
            background: #f8fafc;
        }

        .order-table th {
            padding: 15px 16px;
            color: #475569;
            font-size: 12px;
            font-weight: 700;
            text-align: left;
            text-transform: uppercase;
            border-bottom: 1px solid #e2e8f0;
            white-space: nowrap;
        }

        .order-table td {
            padding: 16px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
            font-size: 14px;
        }

        .order-table tbody tr:hover {
            background: #fffafa;
        }

        .order-table tbody tr:last-child td {
            border-bottom: none;
        }

    /* ORDER INFORMATION */
    .order-id {
        color: #c0392b;
        font-weight: 700;
    }

    .order-customer {
        color: #334155;
        font-weight: 600;
        min-width: 130px;
    }

    .order-date {
        color: #64748b;
        white-space: nowrap;
    }

    .order-money {
        color: #dc2626;
        font-weight: 700;
        white-space: nowrap;
    }

    /* PAYMENT METHOD */
    .order-payment {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 11px;
        color: #475569;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    /* ORDER STATUS */
    .order-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 7px 11px;
        border: 1px solid transparent;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-pending {
        color: #a16207;
        background: #fef9c3;
        border-color: #fde68a;
    }

    .status-confirmed {
        color: #1d4ed8;
        background: #dbeafe;
        border-color: #bfdbfe;
    }

    .status-preparing {
        color: #0369a1;
        background: #e0f2fe;
        border-color: #bae6fd;
    }

    .status-shipping {
        color: #7e22ce;
        background: #f3e8ff;
        border-color: #e9d5ff;
    }

    .status-delivered {
        color: #15803d;
        background: #dcfce7;
        border-color: #bbf7d0;
    }

    .status-cancelled {
        color: #dc2626;
        background: #fef2f2;
        border-color: #fecaca;
    }

    /* DETAIL BUTTON */
    .btn-order-detail {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 8px 13px;
        color: #fff;
        background: #e74c3c;
        border: 1px solid #e74c3c;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none !important;
        transition: .2s;
        white-space: nowrap;
    }

        .btn-order-detail:hover {
            color: #fff;
            background: #c0392b;
            border-color: #c0392b;
        }

    /* EMPTY */
    .order-empty {
        padding: 45px 20px !important;
        color: #94a3b8;
        text-align: center;
    }

        .order-empty i {
            display: block;
            margin-bottom: 12px;
            color: #cbd5e1;
            font-size: 35px;
        }

    /* SUMMARY */
    .order-summary {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 16px 20px;
        color: #475569;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }

        .order-summary strong {
            color: #c0392b;
            font-size: 16px;
        }

    /* ALERT */
    .order-alert {
        margin-bottom: 18px;
        padding: 12px 16px;
        border-radius: 8px;
    }

    @@media (max-width: 768px) {
        .order-page {
            padding: 15px 10px;
        }

        .order-header h2 {
            font-size: 23px;
        }

        .order-table th,
        .order-table td {
            padding: 12px 10px;
        }
    }
</style>

<div class="order-page">

    <!-- HEADER -->
    <div class="order-header">
        <h2>QUẢN LÝ ĐƠN HÀNG</h2>

        <p>
            Theo dõi đơn hàng, phương thức thanh toán
            và trạng thái xử lý tại ToyStore.
        </p>
    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success order-alert">
            <i class="fa-solid fa-circle-check"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger order-alert">
            <i class="fa-solid fa-circle-exclamation"></i>
            @TempData["Error"]
        </div>
    }

    <!-- TABLE -->
    <div class="order-card">

        <div class="order-card-top">
            <h4>
                <i class="fa-solid fa-receipt"></i>
                &nbsp; Danh sách đơn hàng
            </h4>
        </div>

        <div class="table-responsive">

            <table class="order-table">

                <thead>
                    <tr>
                        <th>Mã đơn hàng</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt hàng</th>
                        <th>Tổng tiền</th>
                        <th>Thanh toán</th>
                        <th>Trạng thái đơn hàng</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            string status = string.IsNullOrWhiteSpace(item.OrderStatus)
                                ? "Chờ xác nhận"
                                : item.OrderStatus.Trim();

                            string statusClass = "status-pending";
                            string statusIcon = "fa-clock";

                            switch (status)
                            {
                                case "Chờ xác nhận":
                                    statusClass = "status-pending";
                                    statusIcon = "fa-clock";
                                    break;

                                case "Đã xác nhận":
                                    statusClass = "status-confirmed";
                                    statusIcon = "fa-circle-check";
                                    break;

                                case "Đang chuẩn bị hàng":
                                    statusClass = "status-preparing";
                                    statusIcon = "fa-box";
                                    break;

                                case "Đang giao hàng":
                                    statusClass = "status-shipping";
                                    statusIcon = "fa-truck";
                                    break;

                                case "Đã giao hàng":
                                    statusClass = "status-delivered";
                                    statusIcon = "fa-check-double";
                                    break;

                                case "Đã hủy":
                                    statusClass = "status-cancelled";
                                    statusIcon = "fa-ban";
                                    break;
                            }

                            <tr>

                                <!-- MÃ ĐƠN HÀNG -->
                                <td>
                                    <span class="order-id">
                                        #@item.OrderID
                                    </span>
                                </td>

                                <!-- KHÁCH HÀNG -->
                                <td>
                                    <span class="order-customer">
                                        @(item.Customer != null
                                            ? item.Customer.CustomerName
                                            : "Không xác định")
                                    </span>
                                </td>

                                <!-- NGÀY ĐẶT -->
                                <td>
                                    <span class="order-date">
                                        @item.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </td>

                                <!-- TỔNG TIỀN -->
                                <td>
                                    <span class="order-money">
                                        @item.TotalAmount.ToString("N0") đ
                                    </span>
                                </td>

                                <!-- PHƯƠNG THỨC THANH TOÁN -->
                                <td>
                                    <span class="order-payment">
                                        @(string.IsNullOrWhiteSpace(item.PaymentStatus)
                                            ? "Chưa cập nhật"
                                            : item.PaymentStatus)
                                    </span>
                                </td>

                                <!-- TRẠNG THÁI ĐƠN HÀNG -->
                                <td>
                                    <span class="order-status @statusClass">
                                        <i class="fa-solid @statusIcon"></i>
                                        @status
                                    </span>
                                </td>

                                <!-- THAO TÁC -->
                                <td>

                                    @Html.ActionLink(
                                             "Chi tiết",
                                             "Details",
                                             "Orders",
                                             new
                                             {
                                                 area = "Admin",
                                                 id = item.OrderID
                                             },
                                             new
                                             {
                                                 @class = "btn-order-detail"
                                             }
                                         )

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="order-empty">
                                <i class="fa-solid fa-box-open"></i>
                                Chưa có đơn hàng nào trong hệ thống.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- SUMMARY -->
        <div class="order-summary">

            <span>
                Tổng số đơn hàng:
                <strong>@totalOrders</strong>
            </span>

            <span>
                Tổng giá trị đơn hàng:
                <strong>@totalOrderValue.ToString("N0") đ</strong>
            </span>

        </div>

    </div>

</div>
