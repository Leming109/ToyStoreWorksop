@model ToyStoreBE.Models.MyModel.AdminLoginViewModel

@{
    ViewBag.Title = "Đăng nhập quản trị";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Đăng nhập quản trị</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: #f1f5f9;
            font-family: Arial, sans-serif;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            padding: 35px;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            box-shadow: 0 10px 35px rgba(15, 23, 42, .08);
        }

        .login-icon {
            width: 65px;
            height: 65px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 18px;
            color: #fff;
            background: #e74c3c;
            border-radius: 16px;
            font-size: 27px;
        }

        h2 {
            margin: 0;
            text-align: center;
            color: #1e293b;
            font-size: 24px;
        }

        .subtitle {
            margin: 10px 0 25px;
            text-align: center;
            color: #64748b;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 18px;
        }

            .form-group label {
                display: block;
                margin-bottom: 8px;
                color: #334155;
                font-size: 14px;
                font-weight: 600;
            }

        .form-control {
            width: 100%;
            height: 45px;
            padding: 10px 13px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            outline: none;
            font-size: 14px;
        }

            .form-control:focus {
                border-color: #e74c3c;
                box-shadow: 0 0 0 3px rgba(231, 76, 60, .12);
            }

        .remember {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 5px 0 20px;
            color: #475569;
            font-size: 14px;
        }

        .btn-login {
            width: 100%;
            height: 46px;
            border: none;
            border-radius: 8px;
            color: #fff;
            background: #e74c3c;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: .2s;
        }

            .btn-login:hover {
                background: #c0392b;
            }

        .validation-summary-errors,
        .field-validation-error {
            color: #dc2626;
            font-size: 13px;
        }

        .validation-summary-errors {
            margin-bottom: 15px;
        }

            .validation-summary-errors ul {
                padding-left: 20px;
            }

        .back-home {
            display: block;
            margin-top: 22px;
            text-align: center;
            color: #64748b;
            font-size: 13px;
            text-decoration: none;
        }

            .back-home:hover {
                color: #c0392b;
            }
    </style>
</head>

<body>

    <div class="login-card">

        <div class="login-icon">
            <i class="fa-solid fa-shield-halved"></i>
        </div>

        <h2>ĐĂNG NHẬP QUẢN TRỊ</h2>

        <p class="subtitle">
            ToyStoreBE - Admin Management System
        </p>

        @using (Html.BeginForm(
            "Login",
            "Account",
            new { area = "Admin" },
            FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.Hidden(
                     "returnUrl",
                     ViewBag.ReturnUrl as string
                 )

            @Html.ValidationSummary(
                     false,
                     "",
                     new { @class = "text-danger" }
                 )

            <div class="form-group">

                @Html.LabelFor(
                         m => m.Username,
                         "Tên đăng nhập"
                     )

                @Html.TextBoxFor(
                         m => m.Username,
                         new
                         {
                             @class = "form-control",
                             placeholder = "Nhập tên đăng nhập...",
                             autocomplete = "username"
                         }
                     )

                @Html.ValidationMessageFor(
                         m => m.Username,
                         "",
                         new { @class = "text-danger" }
                     )

            </div>

            <div class="form-group">

                @Html.LabelFor(
                         m => m.Password,
                         "Mật khẩu"
                     )

                @Html.PasswordFor(
                         m => m.Password,
                         new
                         {
                             @class = "form-control",
                             placeholder = "Nhập mật khẩu...",
                             autocomplete = "current-password"
                         }
                     )

                @Html.ValidationMessageFor(
                         m => m.Password,
                         "",
                         new { @class = "text-danger" }
                     )

            </div>

            <label class="remember">
                @Html.CheckBoxFor(m => m.RememberMe)
                Ghi nhớ đăng nhập
            </label>

            <button type="submit" class="btn-login">
                <i class="fa-solid fa-right-to-bracket"></i>
                Đăng nhập
            </button>
        }

        <a href="@Url.Action("Index", "Home", new { area = "" })"
           class="back-home">
            <i class="fa-solid fa-arrow-left"></i>
            Quay lại trang chủ
        </a>

    </div>

</body>
</html>