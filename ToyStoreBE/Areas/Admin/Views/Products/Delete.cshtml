@model ToyStoreBE.Models.Product

@{
    ViewBag.Title = "Xóa Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminsLayout.cshtml";
}

<style>
    .delete-page {
        max-width: 1200px;
        margin: 25px auto;
        padding: 0 20px 30px;
        color: #1e293b;
    }

    .delete-heading {
        margin-bottom: 20px;
    }

        .delete-heading h2 {
            margin: 0 0 8px;
            font-size: 28px;
            font-weight: 700;
            color: #b91c1c;
        }

    .delete-warning {
        margin: 0 0 22px;
        padding: 14px 18px;
        border: 1px solid #fecaca;
        border-left: 5px solid #dc2626;
        border-radius: 8px;
        background: #fef2f2;
        color: #991b1b;
        font-size: 15px;
        font-weight: 600;
    }

    .delete-card {
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        background: #fff;
        box-shadow: 0 6px 22px rgba(15, 23, 42, .05);
    }

    .delete-card-header {
        padding: 18px 24px;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
        font-size: 17px;
        font-weight: 700;
    }

    .delete-card-body {
        padding: 24px;
    }

    .delete-actions {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 10px;
        padding: 18px 24px;
        border-top: 1px solid #e2e8f0;
        background: #f8fafc;
    }

    .delete-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 18px;
        border: 0;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none !important;
        cursor: pointer;
    }

    .delete-btn-danger {
        color: #fff;
        background: #dc2626;
    }

        .delete-btn-danger:hover {
            color: #fff;
            background: #b91c1c;
        }

    .delete-btn-back {
        color: #334155;
        background: #e2e8f0;
    }

        .delete-btn-back:hover {
            color: #0f172a;
            background: #cbd5e1;
        }

    @@media (max-width: 600px) {
        .delete-page {
            padding: 0 10px 20px;
        }

        .delete-card-body {
            padding: 15px;
        }

        .delete-actions {
            padding: 15px;
        }

        .delete-btn {
            flex: 1;
        }
    }
</style>

<div class="delete-page">
    <div class="delete-heading">
        <h2>Xóa sản phẩm</h2>
    </div>

    <div class="delete-warning" role="alert">
        Cảnh báo: Thao tác này sẽ xóa sản phẩm khỏi hệ thống và không thể hoàn tác.
        Vui lòng kiểm tra kỹ trước khi xác nhận.
    </div>

    <div class="delete-card">
        <div class="delete-card-header">
            Thông tin sản phẩm cần xóa
        </div>

        <div class="delete-card-body">
            @Html.Partial("PV_ProductInfo", Model)
        </div>

        @using (Html.BeginForm("Delete", "Products", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.ProductID)

            <div class="delete-actions">
                @Html.ActionLink(
                    "Quay lại danh sách",
                    "Index",
                    null,
                    new { @class = "delete-btn delete-btn-back" }
                )

                <button type="submit"
                        class="delete-btn delete-btn-danger"
                        onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này không? Thao tác này không thể hoàn tác.');">
                    Xóa sản phẩm
                </button>
            </div>
        }
    </div>
</div>