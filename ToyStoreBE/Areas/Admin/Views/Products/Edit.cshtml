@model ToyStoreBE.Models.Product

@{
    ViewBag.Title = "Cập nhật sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminsLayout.cshtml";
}

<style>
    .edit-product-page {
        max-width: 1050px;
        margin: 25px auto;
        padding: 0 20px;
        color: #1e293b;
    }

    .edit-heading {
        margin-bottom: 22px;
    }

        .edit-heading h2 {
            margin: 0 0 8px;
            font-size: 27px;
            font-weight: 700;
            color: #0f172a;
        }

        .edit-heading p {
            margin: 0;
            color: #64748b;
            font-size: 14px;
        }

    .edit-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .05);
    }

    .edit-card-header {
        padding: 20px 26px;
        background: #fff7f7;
        border-bottom: 1px solid #fee2e2;
    }

        .edit-card-header h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 700;
            color: #9f3027;
        }

    .edit-card-body {
        padding: 26px;
    }

    .edit-validation {
        margin-bottom: 18px;
    }

    .edit-actions {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 10px;
        padding: 18px 26px;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }

    .edit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 10px 18px;
        border: 0;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none !important;
        cursor: pointer;
        transition: .2s;
    }

    .edit-btn-save {
        color: #fff;
        background: #e74c3c;
        border: 1px solid #e74c3c;
    }

        .edit-btn-save:hover {
            color: #fff;
            background: #c0392b;
            border-color: #c0392b;
        }

    .edit-btn-back {
        color: #334155;
        background: #e2e8f0;
        border: 1px solid #cbd5e1;
    }

        .edit-btn-back:hover {
            color: #1e293b;
            background: #cbd5e1;
        }

    /* Đồng bộ màu các ô nhập */
    .edit-card-body .form-control:focus {
        border-color: #e74c3c;
        box-shadow: 0 0 0 3px rgba(231, 76, 60, .12);
        outline: none;
    }

    .edit-validation {
        color: #dc2626;
    }

    @@media (max-width: 600px) {
        .edit-product-page {
            padding: 0 10px;
        }

        .edit-card-body {
            padding: 18px;
        }

        .edit-actions {
            padding: 16px 18px;
        }

            .edit-actions .edit-btn {
                flex: 1;
            }
    }
</style>

<div class="edit-product-page">

    <!-- TIÊU ĐỀ -->
    <div class="edit-heading">
        <h2>CẬP NHẬT SẢN PHẨM</h2>
        <p>
            Chỉnh sửa thông tin, giá bán, số lượng tồn kho
            và hình ảnh sản phẩm.
        </p>
    </div>

    <!-- FORM CẬP NHẬT -->
    @using (Html.BeginForm(
        "Edit",
        "Products",
        new
        {
            area = "Admin",
            id = Model.ProductID
        },
        FormMethod.Post,
        new
        {
            enctype = "multipart/form-data"
        }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(model => model.ProductID)

        <div class="edit-card">

            <div class="edit-card-header">
                <h3>
                    <i class="fa-solid fa-pen-to-square"></i>
                    Thông tin sản phẩm
                </h3>
            </div>

            <div class="edit-card-body">

                @Html.ValidationSummary(
                         true,
                         "",
                         new { @class = "text-danger edit-validation" }
                     )

                @Html.Partial("PV_Product", Model)

            </div>

            <div class="edit-actions">

                @Html.ActionLink(
                         "Quay lại danh sách",
                         "Index",
                         "Products",
                         new { area = "Admin" },
                         new { @class = "edit-btn edit-btn-back" }
                     )

                <button type="submit" class="edit-btn edit-btn-save">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Lưu thay đổi
                </button>

            </div>

        </div>
    }

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}