@model ToyStoreBE.Models.Product

@{
    ViewBag.Title = "Chi Tiết Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_AdminsLayout.cshtml";
}

<style>
    .product-detail {
        max-width: 1100px;
        margin: 30px auto;
        padding: 28px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, .06);
    }

    .detail-heading {
        margin: 0 0 24px;
        color: #1e293b;
        font-size: 28px;
        font-weight: 700;
    }

    .product-layout {
        display: grid;
        grid-template-columns: 340px minmax(0, 1fr);
        gap: 32px;
        align-items: start;
    }

    .product-image {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 300px;
        padding: 18px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
    }

        .product-image img {
            display: block;
            max-width: 100%;
            max-height: 300px;
            object-fit: contain;
        }

    .product-name {
        margin: 0 0 16px;
        color: #0f172a;
        font-size: 26px;
        line-height: 1.4;
        font-weight: 700;
    }

    .product-price {
        margin-bottom: 20px;
        color: #dc2626;
        font-size: 28px;
        font-weight: 700;
    }

    .product-meta {
        margin-bottom: 20px;
        color: #475569;
        font-size: 16px;
    }

    .product-description {
        color: #475569;
        line-height: 1.8;
        white-space: pre-line;
    }

        .product-description strong {
            display: block;
            margin-bottom: 6px;
            color: #1e293b;
        }

    .detail-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 28px;
    }

    .detail-btn {
        display: inline-block;
        padding: 11px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
    }

    .edit-btn {
        color: #fff;
        background: #2563eb;
    }

        .edit-btn:hover {
            color: #fff;
            background: #1d4ed8;
            text-decoration: none;
        }

    .back-btn {
        color: #334155;
        background: #e2e8f0;
    }

        .back-btn:hover {
            color: #0f172a;
            background: #cbd5e1;
            text-decoration: none;
        }

    @@media (max-width: 768px) {
        .product-layout {
            grid-template-columns: 1fr;
        }

        .product-image {
            min-height: 220px;
        }

        .product-name {
            font-size: 22px;
        }
    }
</style>

<h2 class="detail-heading">Chi tiết sản phẩm</h2>

<div class="product-detail">
    <div class="product-layout">
        <div class="product-image">
            <img src="@Url.Content(Model.ProductImage)"
                 alt="@Model.ProductName" />
        </div>

        <div class="product-info">
            <h3 class="product-name">@Model.ProductName</h3>

            <div class="product-price">
                @string.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"),
                    "{0:N0} VNĐ", Model.ProductPrice)
            </div>

            <div class="product-meta">
                <strong>Danh mục:</strong>
                @(Model.Category != null ? Model.Category.CategoryName : "Chưa phân loại")
            </div>

            <div class="product-description">
                <strong>Mô tả sản phẩm</strong>
                @Model.ProductDecription
            </div>

            <div class="detail-actions">
                @Html.ActionLink(
                    "Sửa sản phẩm",
                    "Edit",
                    new { id = Model.ProductID },
                    new { @class = "detail-btn edit-btn" })

                @Html.ActionLink(
                    "Quay lại danh sách",
                    "Index",
                    null,
                    new { @class = "detail-btn back-btn" })
            </div>
        </div>
    </div>
</div>