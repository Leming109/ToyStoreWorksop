@model ToyStoreBE.Models.ViewModels.SearchProductVM

@{
    ViewBag.Title = "Quản lý hàng hóa";
    Layout = "~/Areas/Admin/Views/Shared/_AdminsLayout.cshtml";
}

<style>
    .product-search-page {
        padding: 10px 0 25px;
        color: #1e293b;
    }

    .product-search-header {
        margin-bottom: 25px;
    }

        .product-search-header h2 {
            font-size: 28px;
            font-weight: 700;
            margin: 0 0 8px;
            color: #1e293b;
        }

        .product-search-header p {
            color: #64748b;
            margin: 0;
            font-size: 14px;
        }

    /* KHUNG TÌM KIẾM */
    .search-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 25px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.04);
    }

    .search-card-title {
        font-size: 18px;
        font-weight: 600;
        margin: 0 0 22px;
        color: #334155;
    }

    .search-form {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr auto;
        gap: 15px;
        align-items: end;
    }

    .search-field label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 8px;
        color: #475569;
    }

    .search-field .form-control {
        height: 45px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 14px;
        box-shadow: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .search-field .form-control:focus {
            border-color: #e74c3c;
            box-shadow: 0 0 0 3px rgba(231, 76, 60, 0.12);
            outline: none;
        }

    .search-actions {
        display: flex;
        gap: 8px;
    }

    .btn-search {
        height: 45px;
        padding: 0 20px;
        border-radius: 8px;
        background: #e74c3c;
        border: 1px solid #e74c3c;
        color: #fff;
        font-weight: 600;
        white-space: nowrap;
        transition: .2s;
    }

        .btn-search:hover {
            background: #c0392b;
            border-color: #c0392b;
            color: #fff;
        }

    .btn-reset {
        height: 45px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 16px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        color: #475569;
        background: #fff;
        text-decoration: none;
        white-space: nowrap;
    }

        .btn-reset:hover {
            background: #fff1ef;
            border-color: #f5b7b1;
            color: #c0392b;
            text-decoration: none;
        }

    /* THANH SẮP XẾP */
    .sort-card {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        padding: 16px 20px;
        margin-bottom: 25px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
    }

    .sort-label {
        font-size: 14px;
        font-weight: 600;
        color: #475569;
        margin-right: 5px;
    }

    .sort-link {
        display: inline-block;
        padding: 8px 13px;
        border: 1px solid #e2e8f0;
        border-radius: 7px;
        background: #fff;
        color: #475569;
        font-size: 13px;
        text-decoration: none;
        transition: all 0.2s;
    }

        .sort-link:hover {
            background: #fff1ef;
            border-color: #f5b7b1;
            color: #c0392b;
            text-decoration: none;
        }

    /* RESPONSIVE */
    @@media (max-width: 1000px) {
        .search-form {
            grid-template-columns: 1fr 1fr;
        }

        .search-actions {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 600px) {
        .search-form {
            grid-template-columns: 1fr;
        }

        .search-actions {
            grid-column: auto;
        }

            .search-actions button,
            .search-actions a {
                flex: 1;
            }

        .search-card {
            padding: 18px;
        }

        .product-search-header h2 {
            font-size: 23px;
        }
    }
</style>

<div class="product-search-page">

    <!-- TIÊU ĐỀ -->
    <div class="product-search-header">
        <h2>QUẢN LÝ HÀNG HÓA</h2>
        <p>Tìm kiếm, lọc và sắp xếp sản phẩm trong cửa hàng ToyStore.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- TÌM KIẾM -->
    <div class="search-card">

        <h4 class="search-card-title">
            <i class="fa-solid fa-magnifying-glass"></i>
            Tìm kiếm sản phẩm
        </h4>

        @using (Html.BeginForm(
            "Index",
            "Products",
            new { area = "Admin" },
            FormMethod.Get))
        {
            <div class="search-form">

                <div class="search-field">
                    <label for="SearchTerm">Tên sản phẩm</label>

                    @Html.TextBoxFor(m => m.SearchTerm, new
                    {
                        @class = "form-control",
                        placeholder = "Nhập tên sản phẩm..."
                    })
                </div>

                <div class="search-field">
                    <label for="MinPrice">Giá tối thiểu</label>

                    @Html.TextBoxFor(m => m.MinPrice, new
                    {
                        @class = "form-control",
                        placeholder = "Từ giá...",
                        type = "number",
                        min = "0",
                        step = "any"
                    })
                </div>

                <div class="search-field">
                    <label for="MaxPrice">Giá tối đa</label>

                    @Html.TextBoxFor(m => m.MaxPrice, new
                    {
                        @class = "form-control",
                        placeholder = "Đến giá...",
                        type = "number",
                        min = "0",
                        step = "any"
                    })
                </div>

                <div class="search-actions">

                    <button type="submit" class="btn btn-search">
                        <i class="fa-solid fa-search"></i>
                        Tìm kiếm
                    </button>

                    <a href="@Url.Action("Index", "Products", new { area = "Admin" })"
                       class="btn-reset">
                        Xóa lọc
                    </a>

                </div>

            </div>
        }
    </div>

    <!-- SẮP XẾP -->
    <div class="sort-card">

        <span class="sort-label">Sắp xếp theo:</span>

        @Html.ActionLink(
                      "Tên A - Z",
                      "Index",
                      "Products",
                      new
                      {
                          area = "Admin",
                          sortOrder = "name_asc",
                          searchTerm = Model.SearchTerm,
                          minPrice = Model.MinPrice,
                          maxPrice = Model.MaxPrice
                      },
                      new { @class = "sort-link" }
                  )

        @Html.ActionLink(
                      "Tên Z - A",
                      "Index",
                      "Products",
                      new
                      {
                          area = "Admin",
                          sortOrder = "name_desc",
                          searchTerm = Model.SearchTerm,
                          minPrice = Model.MinPrice,
                          maxPrice = Model.MaxPrice
                      },
                      new { @class = "sort-link" }
                  )

        @Html.ActionLink(
                      "Giá thấp đến cao",
                      "Index",
                      "Products",
                      new
                      {
                          area = "Admin",
                          sortOrder = "price_asc",
                          searchTerm = Model.SearchTerm,
                          minPrice = Model.MinPrice,
                          maxPrice = Model.MaxPrice
                      },
                      new { @class = "sort-link" }
                  )

        @Html.ActionLink(
                      "Giá cao đến thấp",
                      "Index",
                      "Products",
                      new
                      {
                          area = "Admin",
                          sortOrder = "price_desc",
                          searchTerm = Model.SearchTerm,
                          minPrice = Model.MinPrice,
                          maxPrice = Model.MaxPrice
                      },
                      new { @class = "sort-link" }
                  )

    </div>

    <!-- DANH SÁCH SẢN PHẨM -->
    <div class="product-list-container">
        @Html.Partial("PV_ProductList", Model)
    </div>

</div>