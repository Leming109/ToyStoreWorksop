
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

    <title>@ViewBag.Title - ToyStore Admin</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background: #f8fafc;
        }

        /* ================= SIDEBAR ================= */

        aside {
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            background: #ffffff;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            padding: 20px 10px;
            z-index: 1000;
        }

            /* LOGO */

            aside .top {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 15px;
                margin-bottom: 30px;
                flex-shrink: 0;
            }

            aside .logo a {
                text-decoration: none;
            }

            aside .logo h2 {
                font-size: 24px;
                color: #333333;
                margin: 0;
                font-weight: 600;
            }

            aside .logo .danger {
                color: #e74c3c;
            }

            /* MENU */

            aside .sidebar {
                display: flex;
                flex-direction: column;
                gap: 8px;
                padding: 0;
                flex-shrink: 0;
            }

                aside .sidebar a {
                    display: flex;
                    align-items: center;
                    gap: 15px;
                    padding: 14px 16px;
                    color: #555555;
                    text-decoration: none;
                    font-size: 15px;
                    border-radius: 8px;
                    transition: all 0.2s ease;
                }

                    aside .sidebar a i {
                        width: 20px;
                        text-align: center;
                        font-size: 18px;
                        flex-shrink: 0;
                    }

                    aside .sidebar a:hover,
                    aside .sidebar a.active {
                        background-color: #e74c3c;
                        color: #ffffff;
                    }

        /* ================= ACCOUNT BOTTOM ================= */

        .sidebar-account {
            margin-top: auto;
            padding: 15px 10px 5px;
            border-top: 1px solid #eeeeee;
            flex-shrink: 0;
        }

        .account-information {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 5px 14px;
        }

        .account-avatar {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            background: #fff1ef;
            color: #e74c3c;
            border-radius: 50%;
            font-size: 18px;
        }

        .account-detail {
            flex: 1;
            min-width: 0;
        }

        .account-name {
            display: block;
            color: #1e293b;
            font-size: 13px;
            font-weight: 700;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .account-role {
            display: inline-block;
            margin-top: 5px;
            padding: 3px 8px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
        }

        .role-superadmin {
            color: #b91c1c;
            background: #fee2e2;
        }

        .role-moderator {
            color: #1d4ed8;
            background: #dbeafe;
        }

        /* BUTTON LOGIN / LOGOUT */

        .sidebar-account-action {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            min-height: 43px;
            padding: 11px;
            border: 1px solid #fecaca;
            border-radius: 8px;
            background: #fff1ef;
            color: #c0392b;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .sidebar-account-action:hover {
                color: #ffffff;
                background: #e74c3c;
                border-color: #e74c3c;
            }

        .logout-form {
            width: 100%;
            margin: 0;
        }

        /* ================= MAIN CONTENT ================= */

        .admin-content {
            margin-left: 250px;
            width: calc(100% - 250px);
            min-height: 100vh;
            padding: 20px 25px;
            display: flex;
            flex-direction: column;
        }

        .page-content {
            flex: 1 0 auto;
            min-width: 0;
        }

        /* FOOTER */

        .admin-content footer {
            margin-top: 30px;
        }

        /* RESPONSIVE */

        @@media (max-width: 768px) {
            aside {
                width: 210px;
            }

            .admin-content {
                margin-left: 210px;
                width: calc(100% - 210px);
                padding: 15px;
            }
        }

        @@media (max-width: 520px) {
            aside {
                width: 75px;
                padding: 15px 7px;
            }

                aside .logo h2 {
                    font-size: 17px;
                }

                aside .top {
                    padding: 0 3px;
                    justify-content: center;
                }

                aside .sidebar a {
                    justify-content: center;
                    padding: 14px 5px;
                }

                    aside .sidebar a span {
                        display: none;
                    }

                    aside .sidebar a i {
                        font-size: 19px;
                    }

            .account-information {
                justify-content: center;
                padding: 8px 0;
            }

            .account-detail {
                display: none;
            }

            .sidebar-account {
                padding: 12px 2px 5px;
            }

            .sidebar-account-action {
                padding: 11px 3px;
            }

                .sidebar-account-action span {
                    display: none;
                }

            .admin-content {
                margin-left: 75px;
                width: calc(100% - 75px);
                padding: 12px;
            }
        }
    </style>
</head>

<body>

    @{
        string adminRole = ViewBag.AdminRole as string ?? "";
        string adminUsername = ViewBag.AdminUsername as string ?? "";

        bool isAuthenticated =
            User != null &&
            User.Identity != null &&
            User.Identity.IsAuthenticated;

        string roleName =
            adminRole == "A" ? "SuperAdmin" :
            adminRole == "M" ? "Moderator" : "Quản trị viên";
    }

    <!-- ================= SIDEBAR ================= -->

    <aside>

        <!-- LOGO -->
        <div class="top">

            <div class="logo">

                <a href="@Url.Action("Index", "Admin", new { area = "Admin" })">

                    <h2>
                        Toy<span class="danger">Store</span>
                    </h2>

                </a>

            </div>

        </div>

        <!-- MENU -->
        <div class="sidebar">

            <a href="@Url.Action("Index", "Categories", new { area = "Admin" })">
                <i class="fa-solid fa-list"></i>
                <span>Danh Mục</span>
            </a>

            <a href="@Url.Action("Index", "Products", new { area = "Admin" })">
                <i class="fa-brands fa-dropbox"></i>
                <span>Hàng Hóa</span>
            </a>

            <!-- CHỈ SUPERADMIN ĐƯỢC NHÌN THẤY -->
            @if (adminRole == "A")
            {
                <a href="@Url.Action("Index", "Users", new { area = "Admin" })">
                    <i class="fa-solid fa-user-shield"></i>
                    <span>Người Dùng</span>
                </a>
            }

            <a href="@Url.Action("Index", "Customers", new { area = "Admin" })">
                <i class="fa-solid fa-users"></i>
                <span>Khách Hàng</span>
            </a>

            <a href="@Url.Action("Index", "Orders", new { area = "Admin" })">
                <i class="fa-solid fa-basket-shopping"></i>
                <span>Đơn Hàng</span>
            </a>

        </div>

        <!-- TÀI KHOẢN Ở CUỐI SIDEBAR -->
        <div class="sidebar-account">

            @if (isAuthenticated)
            {
                <div class="account-information">

                    <div class="account-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div class="account-detail">

                        <span class="account-name">
                            @(!string.IsNullOrWhiteSpace(adminUsername)
                                ? adminUsername
                                : User.Identity.Name)
                        </span>

                        <span class="account-role @(adminRole == "A" ? "role-superadmin" : "role-moderator")">
                            @roleName
                        </span>

                    </div>

                </div>

                using (Html.BeginForm(
                    "Logout",
                    "Account",
                    new { area = "Admin" },
                    FormMethod.Post,
                    new { @class = "logout-form" }))
                {
                    @Html.AntiForgeryToken()

                    <button type="submit" class="sidebar-account-action">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Đăng xuất</span>
                    </button>
                }
            }
            else
            {
                <a href="@Url.Action("Login", "Account", new { area = "Admin" })"
                   class="sidebar-account-action">

                    <i class="fa-solid fa-right-to-bracket"></i>
                    <span>Đăng nhập</span>

                </a>
            }

        </div>

    </aside>

    <!-- ================= MAIN CONTENT ================= -->

    <div class="admin-content">

        <main class="page-content">

            @RenderBody()

        </main>

        <!-- FOOTER -->
        <footer>

            <hr />

            <p>&copy; @DateTime.Now.Year - ToyStore</p>

            <h4>Contact</h4>

            <p>Nguyễn Lê Minh Khang _ 25DH110096</p>

            <p>Nguyễn lê quốc bảo _ 25DH110940</p>

            <p>Nguyễn Đức Kiên _ 25DH110412</p>

            <p>Đỗ Thế Thành Danh _ 25DH110096</p>

        </footer>

    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

</body>
</html>
