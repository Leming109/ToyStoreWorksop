@model IEnumerable<ToyStoreBE.Models.User>

@{
    ViewBag.Title = "Quản lý người quản trị";
    Layout = "~/Areas/Admin/Views/Shared/_AdminsLayout.cshtml";
}

<style>
    .admin-user-page {
        padding: 22px 25px;
        color: #1e293b;
    }

    .admin-user-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 22px;
    }

        .admin-user-header h2 {
            margin: 0 0 7px;
            font-size: 27px;
            font-weight: 700;
            color: #1e293b;
        }

        .admin-user-header p {
            margin: 0;
            color: #64748b;
            font-size: 14px;
        }

    .admin-user-card {
        overflow: hidden;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 4px 15px rgba(15, 23, 42, .04);
    }

    .admin-user-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
    }

        .admin-user-table thead {
            background: #f1f5f9;
        }

        .admin-user-table th {
            padding: 15px 20px;
            border-bottom: 1px solid #e2e8f0;
            color: #475569;
            font-size: 13px;
            font-weight: 700;
            text-align: left;
            text-transform: uppercase;
        }

        .admin-user-table td {
            padding: 16px 20px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

        .admin-user-table tbody tr:hover {
            background: #f8fafc;
        }

        .admin-user-table tbody tr:last-child td {
            border-bottom: 0;
        }

    .admin-username {
        font-weight: 600;
        color: #334155;
    }

    .admin-role {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 12px;
        font-weight: 600;
    }

    .admin-user-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .admin-user-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 12px;
        border: 1px solid transparent;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none !important;
        cursor: pointer;
        font-family: inherit;
    }

    .admin-user-btn-edit {
        border-color: #bfdbfe;
        background: #eff6ff;
        color: #1d4ed8;
    }

        .admin-user-btn-edit:hover {
            background: #dbeafe;
            color: #1d4ed8;
        }

    .admin-user-btn-delete {
        border-color: #fecaca;
        background: #fef2f2;
        color: #dc2626;
    }

        .admin-user-btn-delete:hover {
            background: #fee2e2;
            color: #dc2626;
        }

    .admin-user-btn-create {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        border-radius: 8px;
        background: #2563eb;
        color: #fff;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none !important;
    }

        .admin-user-btn-create:hover {
            background: #1d4ed8;
            color: #fff;
        }

    .admin-user-empty {
        padding: 30px 20px !important;
        color: #64748b;
        text-align: center;
    }

    .admin-user-alert {
        margin-bottom: 18px;
        padding: 12px 16px;
        border-radius: 8px;
        font-size: 14px;
    }

    .admin-user-delete-form {
        display: inline;
        margin: 0;
    }

    @@media (max-width: 600px) {
        .admin-user-page {
            padding: 15px 10px;
        }

        .admin-user-table th,
        .admin-user-table td {
            padding: 12px 10px;
        }

        .admin-user-header h2 {
            font-size: 22px;
        }
    }
</style>

<div class="admin-user-page">

    <!-- TIÊU ĐỀ VÀ NÚT THÊM -->
    <div class="admin-user-header">
        <div>
            <h2>DANH SÁCH NGƯỜI QUẢN TRỊ</h2>
            <p>Quản lý các tài khoản có quyền quản trị hệ thống.</p>
        </div>

        @Html.ActionLink(
            "＋ Thêm quản trị viên",
            "Create",
            "Users",
            new { area = "Admin" },
            new { @class = "admin-user-btn-create" }
        )
    </div>

    <!-- THÔNG BÁO THÀNH CÔNG -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success admin-user-alert">
            @TempData["Success"]
        </div>
    }

    <!-- THÔNG BÁO LỖI -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger admin-user-alert">
            @TempData["Error"]
        </div>
    }

    <!-- BẢNG DANH SÁCH -->
    <div class="admin-user-card">
        <div class="table-responsive">

            <table class="admin-user-table">

                <thead>
                    <tr>
                        <th>Tên tài khoản</th>
                        <th>Vai trò</th>
                        <th style="width: 220px;">Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- TÊN TÀI KHOẢN -->
                                <td>
                                    <span class="admin-username">
                                        @item.Username.TrimEnd()
                                    </span>
                                </td>

                                <!-- VAI TRÒ -->
                                <td>
                                    <span class="admin-role">
                                        Quản trị viên
                                    </span>
                                </td>

                                <!-- THAO TÁC -->
                                <td>
                                    <div class="admin-user-actions">

                                        <!-- NÚT SỬA -->
                                        @Html.ActionLink(
                                            "Sửa",
                                            "Edit",
                                            "Users",
                                            new
                                            {
                                                area = "Admin",
                                                id = item.Username.TrimEnd()
                                            },
                                            new
                                            {
                                                @class = "admin-user-btn admin-user-btn-edit"
                                            }
                                        )

                                        <!-- NÚT XÓA -->
                                        @using (Html.BeginForm(
                                            "Delete",
                                            "Users",
                                            new
                                            {
                                                area = "Admin",
                                                id = item.Username.TrimEnd()
                                            },
                                            FormMethod.Post,
                                            new
                                            {
                                                @class = "admin-user-delete-form",
                                                onsubmit = "return confirm('Bạn có chắc chắn muốn xóa tài khoản quản trị này không?');"
                                            }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="admin-user-btn admin-user-btn-delete">
                                                Xóa
                                            </button>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="admin-user-empty">
                                Chưa có tài khoản quản trị nào.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>