@model ToyStoreBE.Models.Category

@{
    ViewBag.Title = "Nhập Danh Mục Hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminsLayout.cshtml";
}

<style>
    .category-create-page {
        padding: 20px 25px;
        color: #1e293b;
    }

    .category-create-header {
        margin-bottom: 25px;
    }

        .category-create-header h2 {
            font-size: 28px;
            font-weight: 700;
            margin: 0 0 8px;
            color: #1e293b;
        }

        .category-create-header p {
            font-size: 14px;
            color: #64748b;
            margin: 0;
        }

    .category-create-card {
        max-width: 750px;
        margin: 0 auto;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }

    .category-create-card-header {
        padding: 20px 25px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

        .category-create-card-header h4 {
            font-size: 18px;
            font-weight: 700;
            margin: 0 0 6px;
            color: #334155;
        }

        .category-create-card-header p {
            font-size: 13px;
            color: #64748b;
            margin: 0;
        }

    .category-create-form {
        padding: 25px;
    }

        .category-create-form .form-group {
            margin-bottom: 20px;
        }

        .category-create-form label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 600;
            color: #475569;
        }

        .category-create-form .form-control {
            width: 100%;
            max-width: 100%;
            height: 45px;
            padding: 10px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            box-shadow: none;
            font-size: 15px;
            color: #334155;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .category-create-form .form-control:focus {
                border-color: #3b82f6;
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
                outline: none;
            }

        .category-create-form .text-danger {
            display: block;
            margin-top: 6px;
            font-size: 13px;
        }

    .category-create-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
    }

    .btn-create-submit,
    .btn-create-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 20px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none !important;
        transition: all 0.2s ease;
        cursor: pointer;
    }

    .btn-create-submit {
        color: #fff;
        background: #2563eb;
        border: 1px solid #2563eb;
    }

        .btn-create-submit:hover {
            color: #fff;
            background: #1d4ed8;
            border-color: #1d4ed8;
        }

    .btn-create-back {
        color: #475569;
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
    }

        .btn-create-back:hover {
            color: #1e293b;
            background: #e2e8f0;
        }

    @@media (max-width: 576px) {
        .category-create-page {
            padding: 15px 10px;
        }

        .category-create-header h2 {
            font-size: 22px;
        }

        .category-create-form {
            padding: 18px;
        }

        .category-create-card-header {
            padding: 18px;
        }
    }
</style>

<div class="category-create-page">

    <div class="category-create-header">
        <h2>Thêm danh mục</h2>
        <p>Thêm danh mục sản phẩm mới vào hệ thống ToyStore.</p>
    </div>

    <div class="category-create-card">

        <div class="category-create-card-header">
            <h4>Thông tin danh mục</h4>
            <p>Vui lòng nhập tên danh mục cần thêm.</p>
        </div>

        @using (Html.BeginForm("Create","Categories",new { area = "Admin" },FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="category-create-form">

                @Html.ValidationSummary(
                    true,
                    "",
                    new { @class = "text-danger" }
                )

                @Html.Partial("PartialView_Categories", Model)

                <div class="category-create-actions">

                    <button type="submit" class="btn-create-submit">
                        <i class="fa-solid fa-plus"></i>
                        Thêm danh mục
                    </button>

                    @Html.ActionLink(
                        "Quay lại danh sách",
                        "Index",
                        null,
                        new { @class = "btn-create-back" }
                    )

                </div>

            </div>
        }

    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
