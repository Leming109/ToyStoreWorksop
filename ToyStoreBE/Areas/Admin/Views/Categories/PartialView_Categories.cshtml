@model ToyStoreBE.Models.Category

<style>
    .category-form-group {
        margin-bottom: 20px;
    }

        .category-form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 600;
            color: #475569;
        }

        .category-form-group .form-control {
            width: 100%;
            height: 45px;
            padding: 10px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: 15px;
            color: #334155;
            box-shadow: none;
        }

            .category-form-group .form-control:focus {
                border-color: #3b82f6;
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
                outline: none;
            }

        .category-form-group .text-danger {
            display: block;
            margin-top: 6px;
            font-size: 13px;
        }
</style>

<div class="category-form-group">

    @Html.LabelFor(
        model => model.CategoryName,
        "Tên danh mục"
    )

    @Html.TextBoxFor(
        model => model.CategoryName,
        new
        {
            @class = "form-control",
            placeholder = "Nhập tên danh mục...",
            autocomplete = "off",
            maxlength = "100"
        }
    )

    @Html.ValidationMessageFor(
        model => model.CategoryName,
        "",
        new { @class = "text-danger" }
    )

</div>