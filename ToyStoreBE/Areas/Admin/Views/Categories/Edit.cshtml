@model ToyStoreBE.Models.Category

@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_AdminsLayout.cshtml";
}

<style>
    .category-edit-page {
        padding: 20px 25px;
        color: #1e293b;
    }

    .category-edit-header {
        margin-bottom: 25px;
    }

        .category-edit-header h2 {
            font-size: 28px;
            font-weight: 700;
            margin: 0 0 8px;
            color: #1e293b;
        }

        .category-edit-header p {
            font-size: 14px;
            color: #64748b;
            margin: 0;
        }

    .category-edit-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        overflow: hidden;
        max-width: 850px;
    }

    .category-edit-card-header {
        padding: 20px 25px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

        .category-edit-card-header h4 {
            font-size: 18px;
            font-weight: 700;
            margin: 0 0 6px;
            color: #334155;
        }

        .category-edit-card-header p {
            font-size: 13px;
            color: #64748b;
            margin: 0;
        }

    .category-edit-form {
        padding: 25px;
    }

        .category-edit-form .form-group {
            margin-bottom: 20px;
        }

        .category-edit-form label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            color: #475569;
            margin-bottom: 8px;
        }

        .category-edit-form .form-control {
            width: 100%;
            max-width: 100%;
            height: 45px;
            padding: 10px 14px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            box-shadow: none;
            font-size: 15px;
            color: #334155;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .category-edit-form .form-control:focus {
                border-color: #3b82f6;
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
                outline: none;
            }

        .category-edit-form .text-danger {
            display: block;
            margin-top: 6px;
            font-size: 13px;
        }

    .category-edit-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 25px;
        padding-top: 20px;
        border-top: 1px solid #e2e8f0;
    }

    .btn-edit-save,
    .btn-edit-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 11px 20px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none !important;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
    }

    .btn-edit-save {
        background: #2563eb;
        color: #fff;
    }

        .btn-edit-save:hover {
            background: #1d4ed8;
            color: #fff;
        }

    .btn-edit-back {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #cbd5e1;
    }

        .btn-edit-back:hover {
            background: #e2e8f0;
            color: #1e293b;
        }

    @@media (max-width: 576px) {
        .category-edit-page {
            padding: 15px 10px;
        }

        .category-edit-header h2 {
            font-size: 22px;
        }

        .category-edit-form {
            padding: 18px;
        }
    }
</style>

<div class="category-edit-page">

    <div class="category-edit-header">
        <h2>Cập nhật danh mục</h2>
        <p>Chỉnh sửa thông tin danh mục sản phẩm trong hệ thống ToyStore.</p>
    </div>

    <div class="category-edit-card">

        <div class="category-edit-card-header">
            <h4>Thông tin danh mục</h4>
            <p>Vui lòng nhập tên danh mục cần cập nhật.</p>
        </div>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="category-edit-form">

                @Html.ValidationSummary(
                    true,
                    "",
                    new { @class = "text-danger" }
                )

                @Html.HiddenFor(model => model.CategoryID)

                @Html.Partial("PartialView_Categories", Model)

                <div class="category-edit-actions">

                    <button type="submit" class="btn-edit-save">
                        <i class="fa-solid fa-floppy-disk"></i>
                        &nbsp; Lưu thay đổi
                    </button>

                    @Html.ActionLink(
                        "Quay lại danh sách",
                        "Index",
                        null,
                        new { @class = "btn-edit-back" }
                    )

                </div>

            </div>
        }

    </div>

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
