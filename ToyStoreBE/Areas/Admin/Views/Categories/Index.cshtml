@model ToyStoreBE.Models.ViewModel.CategoryIndexViewModel

@{
    ViewBag.Title = "Danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminsLayout.cshtml";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<style>
    .category-page {
        padding: 20px 25px;
        color: #1e293b;
    }

    .category-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

        .category-header h2 {
            font-size: 28px;
            font-weight: 700;
            margin: 0;
            color: #1e293b;
        }

        .category-header p {
            color: #64748b;
            margin: 8px 0 0;
            font-size: 14px;
        }

    .category-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }

    .category-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
    }

        .category-table thead {
            background: #f1f5f9;
        }

        .category-table th {
            padding: 16px 20px;
            color: #475569;
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            border-bottom: 1px solid #e2e8f0;
        }

        .category-table td {
            padding: 16px 20px;
            vertical-align: middle;
            border-bottom: 1px solid #f1f5f9;
        }

        .category-table tbody tr:hover {
            background: #f8fafc;
        }

        .category-table tbody tr:last-child td {
            border-bottom: none;
        }

    .category-name {
        font-size: 15px;
        font-weight: 500;
        color: #334155;
    }

    .category-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .btn-category {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 14px;
        border-radius: 7px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none !important;
        transition: all 0.2s ease;
    }

    .btn-edit {
        color: #2563eb;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
    }

        .btn-edit:hover {
            color: #fff;
            background: #2563eb;
        }

    .btn-delete {
        color: #dc2626;
        background: #fef2f2;
        border: 1px solid #fecaca;
    }

        .btn-delete:hover {
            color: #fff;
            background: #dc2626;
        }

    .btn-create {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 18px;
        color: #fff;
        background: #2563eb;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none !important;
        transition: background 0.2s ease;
    }

        .btn-create:hover {
            color: #fff;
            background: #1d4ed8;
        }

    .category-empty {
        padding: 35px 20px !important;
        text-align: center;
        color: #94a3b8;
    }

    @@media (max-width: 576px) {
        .category-page {
            padding: 15px 10px;
        }

        .category-header h2 {
            font-size: 22px;
        }

        .category-table th,
        .category-table td {
            padding: 12px 10px;
        }

        .category-table th {
            font-size: 12px;
        }
    }

    .product-count {
        display: inline-block;
        min-width: 34px;
        padding: 5px 10px;
        text-align: center;
        color: #1d4ed8;
        background: #eff6ff;
        border-radius: 20px;
        font-weight: 700;
    }

    .category-summary {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 16px 20px;
        color: #475569;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }

        .category-summary strong {
            color: #0f172a;
        }

    .category-pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        padding: 18px;
    }

    .page-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 36px;
        padding: 8px 12px;
        color: #2563eb;
        background: #fff;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
        text-decoration: none !important;
    }

        .page-link:hover,
        .page-link.active {
            color: #fff;
            background: #2563eb;
            border-color: #2563eb;
        }
</style>

<div class="category-page">

    <div class="category-header">
        <div>
            <h2>Danh sách danh mục</h2>
            <p>Quản lý các danh mục sản phẩm của ToyStore</p>
        </div>

        @Html.ActionLink("＋ Thêm mới", "Create", null,
            new { @class = "btn-create" })
    </div>

    <div class="category-card">
        <div class="table-responsive">
            <table class="category-table">
                <thead>
                    <tr>
                        <th style="width: 50%;">Tên danh mục</th>
                        <th style="width: 20%;">Số lượng hàng hóa</th>
                        <th style="width: 30%;">Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Categories != null && Model.Categories.Any())
                    {
                        foreach (var item in Model.Categories)
                        {
                            <tr>
                                <td>
                                    <span class="category-name">
                                        @item.CategoryName
                                    </span>
                                </td>

                                <td>
                                    <span class="product-count">
                                        @item.ProductCount
                                    </span>
                                </td>

                                <td>
                                    <div class="category-actions">
                                        @Html.ActionLink("Cập nhật", "Edit",
                                            new { id = item.CategoryID },
                                            new { @class = "btn-category btn-edit" })

                                        @Html.ActionLink("Xóa", "Delete",
                                            new { id = item.CategoryID },
                                            new { @class = "btn-category btn-delete" })
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="category-empty">
                                Chưa có danh mục nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="category-summary">
            <span>
                Tổng số hàng hóa:
                <strong>@Model.TotalProducts</strong>
            </span>
            <span>
                Tổng số danh mục:
                <strong>@Model.TotalCategories</strong>
            </span>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="category-pagination">
                @if (Model.Page > 1)
                {
                    @Html.ActionLink("‹ Trước", "Index",
                        new { page = Model.Page - 1 },
                        new { @class = "page-link" })
                }

                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    if (i == Model.Page)
                    {
                        <span class="page-link active">@i</span>
                    }
                    else
                    {
                        @Html.ActionLink(i.ToString(), "Index",
                            new { page = i },
                            new { @class = "page-link" })
                    }
                }

                @if (Model.Page < Model.TotalPages)
                {
                    @Html.ActionLink("Sau ›", "Index",
                        new { page = Model.Page + 1 },
                        new { @class = "page-link" })
                }
            </div>
        }
    </div>
</div>
