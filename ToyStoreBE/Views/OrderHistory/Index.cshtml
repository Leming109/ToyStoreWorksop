@model IEnumerable<ToyStoreBE.Models.Order>

@{
    ViewBag.Title = "Lịch sử giao dịch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .history-page {
        max-width: 1250px;
        margin: 25px auto;
        padding: 0 15px 35px;
        color: #1e293b;
    }

    .history-header {
        margin-bottom: 24px;
    }

        .history-header h2 {
            margin: 0 0 8px;
            color: #1e293b;
            font-size: 27px;
            font-weight: 700;
        }

        .history-header p {
            margin: 0;
            color: #64748b;
            font-size: 14px;
        }

    .history-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 5px 18px rgba(15,23,42,.04);
    }

    .history-card-header {
        padding: 18px 22px;
        background: #fff7f7;
        border-bottom: 1px solid #fee2e2;
        color: #c0392b;
        font-size: 17px;
        font-weight: 700;
    }

    .history-table {
        width: 100%;
        min-width: 1050px;
        border-collapse: collapse;
        margin: 0;
    }

        .history-table thead {
            background: #f8fafc;
        }

        .history-table th {
            padding: 15px;
            color: #64748b;
            font-size: 12px;
            font-weight: 700;
            text-align: left;
            text-transform: uppercase;
            border-bottom: 1px solid #e2e8f0;
            white-space: nowrap;
        }

        .history-table td {
            padding: 16px 15px;
            border-bottom: 1px solid #f1f5f9;
            color: #475569;
            font-size: 14px;
            vertical-align: middle;
        }

        .history-table tbody tr:hover {
            background: #fffafa;
        }

        .history-table tbody tr:last-child td {
            border-bottom: none;
        }

    .history-order-id {
        color: #c0392b;
        font-weight: 700;
    }

    .history-money {
        color: #dc2626;
        font-weight: 700;
        white-space: nowrap;
    }

    /* THANH TOÁN */
    .history-status {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        color: #c0392b;
        background: #fff1ef;
        border: 1px solid #fecaca;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    /* TRẠNG THÁI ĐƠN HÀNG */
    .history-order-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-pending {
        color: #92400e;
        background: #fef3c7;
        border: 1px solid #fde68a;
    }

    .status-confirmed {
        color: #1d4ed8;
        background: #dbeafe;
        border: 1px solid #bfdbfe;
    }

    .status-preparing {
        color: #6d28d9;
        background: #ede9fe;
        border: 1px solid #ddd6fe;
    }

    .status-shipping {
        color: #0369a1;
        background: #e0f2fe;
        border: 1px solid #bae6fd;
    }

    .status-delivered {
        color: #15803d;
        background: #dcfce7;
        border: 1px solid #bbf7d0;
    }

    .status-cancelled {
        color: #b91c1c;
        background: #fee2e2;
        border: 1px solid #fecaca;
    }

    .status-default {
        color: #475569;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
    }

    /* CÁC NÚT THAO TÁC */
    .history-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

    .history-detail-btn,
    .history-reorder-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 36px;
        padding: 8px 12px;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none !important;
        white-space: nowrap;
        cursor: pointer;
        transition: .2s;
    }

    .history-detail-btn {
        color: #fff;
        background: #e74c3c;
        border: 1px solid #e74c3c;
    }

        .history-detail-btn:hover {
            color: #fff;
            background: #c0392b;
            border-color: #c0392b;
        }

    .history-reorder-form {
        display: inline-block;
        margin: 0;
    }

    .history-reorder-btn {
        color: #e74c3c;
        background: #fff;
        border: 1px solid #e74c3c;
    }

        .history-reorder-btn:hover {
            color: #fff;
            background: #e74c3c;
        }

    .history-empty {
        padding: 50px 20px !important;
        text-align: center;
        color: #94a3b8 !important;
    }

        .history-empty i {
            display: block;
            margin-bottom: 13px;
            font-size: 38px;
        }

        .history-empty strong {
            display: block;
            margin-bottom: 6px;
            color: #475569;
            font-size: 16px;
        }

    .history-summary {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 17px 22px;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        color: #475569;
    }

        .history-summary strong {
            color: #c0392b;
        }

    @@media (max-width: 700px) {
        .history-page {
            padding: 0 5px 25px;
        }

        .history-header h2 {
            font-size: 23px;
        }

        .history-table th,
        .history-table td {
            padding: 12px 9px;
        }

        .history-summary {
            padding: 15px;
        }
    }
</style>

<div class="history-page">

    <!-- TIÊU ĐỀ -->
    <div class="history-header">
        <h2>LỊCH SỬ GIAO DỊCH</h2>
        <p>
            Theo dõi các đơn hàng bạn đã đặt tại ToyStore.
        </p>
    </div>

    <div class="history-card">

        <div class="history-card-header">
            <i class="fa-solid fa-clock-rotate-left"></i>
            &nbsp; Đơn hàng của tôi
        </div>

        <div class="table-responsive">

            <table class="history-table">

                <thead>
                    <tr>
                        <th>Mã đơn hàng</th>
                        <th>Ngày đặt</th>
                        <th>Số lượng</th>
                        <th>Tổng thanh toán</th>
                        <th>Thanh toán</th>
                        <th>Trạng thái đơn hàng</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var orderStatus =
                                string.IsNullOrWhiteSpace(item.OrderStatus)
                                ? "Chờ xác nhận"
                                : item.OrderStatus.Trim();

                            var statusClass = "status-default";
                            var statusIcon = "fa-circle-info";

                            switch (orderStatus)
                            {
                                case "Chờ xác nhận":
                                    statusClass = "status-pending";
                                    statusIcon = "fa-clock";
                                    break;

                                case "Đã xác nhận":
                                    statusClass = "status-confirmed";
                                    statusIcon = "fa-circle-check";
                                    break;

                                case "Đang chuẩn bị hàng":
                                    statusClass = "status-preparing";
                                    statusIcon = "fa-box";
                                    break;

                                case "Đang giao hàng":
                                    statusClass = "status-shipping";
                                    statusIcon = "fa-truck";
                                    break;

                                case "Đã giao hàng":
                                    statusClass = "status-delivered";
                                    statusIcon = "fa-check-double";
                                    break;

                                case "Đã hủy":
                                    statusClass = "status-cancelled";
                                    statusIcon = "fa-circle-xmark";
                                    break;
                            }

                            <tr>

                                <!-- MÃ ĐƠN -->
                                <td>
                                    <span class="history-order-id">
                                        #@item.OrderID
                                    </span>
                                </td>

                                <!-- NGÀY ĐẶT -->
                                <td>
                                    @item.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <!-- SỐ LƯỢNG -->
                                <td>
                                    @(item.OrderDetails == null
                                        ? 0
                                        : item.OrderDetails.Sum(d => d.Quantity))
                                </td>

                                <!-- TỔNG THANH TOÁN -->
                                <td>
                                    <span class="history-money">
                                        @item.TotalAmount.ToString("N0") đ
                                    </span>
                                </td>

                                <!-- PHƯƠNG THỨC THANH TOÁN -->
                                <td>
                                    <span class="history-status">
                                        @(string.IsNullOrWhiteSpace(item.PaymentStatus)
                                            ? "Chưa cập nhật"
                                            : item.PaymentStatus)
                                    </span>
                                </td>

                                <!-- TRẠNG THÁI ĐƠN HÀNG -->
                                <td>
                                    <span class="history-order-status @statusClass">
                                        <i class="fa-solid @statusIcon"></i>
                                        @orderStatus
                                    </span>
                                </td>

                                <!-- THAO TÁC -->
                                <td>
                                    <div class="history-actions">

                                        @Html.ActionLink(
                                                 "Xem hóa đơn",
                                                 "Details",
                                                 "OrderHistory",
                                                 new
                                                 {
                                                     area = "",
                                                     id = item.OrderID
                                                 },
                                                 new
                                                 {
                                                     @class = "history-detail-btn"
                                                 }
                                             )

                                        @using (Html.BeginForm(
                                            "BuyAgain",
                                            "OrderHistory",
                                            new
                                            {
                                                area = "",
                                                id = item.OrderID
                                            },
                                            FormMethod.Post,
                                            new
                                            {
                                                @class = "history-reorder-form"
                                            }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="history-reorder-btn">
                                                <i class="fa-solid fa-cart-plus"></i>
                                                Mua lại
                                            </button>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="history-empty">
                                <i class="fa-solid fa-receipt"></i>

                                <strong>Bạn chưa có đơn hàng nào.</strong>

                                Hãy khám phá các sản phẩm tại ToyStore nhé!
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- TỔNG KẾT -->
        <div class="history-summary">

            <span>
                Tổng số đơn hàng:
                <strong>@(Model == null ? 0 : Model.Count())</strong>
            </span>

            <span>
                Tổng giá trị đơn hàng:
                <strong>
                    @(Model == null
                        ? "0"
                        : Model.Sum(o => o.TotalAmount).ToString("N0")) đ
                </strong>
            </span>

        </div>

    </div>

</div>