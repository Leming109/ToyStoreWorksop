@model ToyStoreBE.Models.MyModel.LoginViewModel

@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .auth-page {
        min-height: 570px;
        padding: 25px 20px;
        background: #f2f2f2;
    }

    .auth-panel {
        width: 100%;
        max-width: 1100px;
        min-height: 430px;
        margin: 0 auto;
        padding: 14px;
        background: #fff;
    }

    .auth-heading {
        margin: 0;
        padding: 0 0 10px;
        border-bottom: 1px solid #ddd;
        color: #333;
        font-size: 16px;
        font-weight: 700;
        text-transform: uppercase;
    }

        .auth-heading span {
            display: block;
            width: 140px;
            margin-bottom: -11px;
            padding-bottom: 10px;
            border-bottom: 2px solid #e53935;
        }

    .auth-form {
        width: 100%;
        max-width: 320px;
        margin: 26px auto;
    }

    .auth-input-group {
        display: flex;
        align-items: center;
        height: 38px;
        margin-bottom: 8px;
        border: 1px solid #ddd;
        background: #fff;
    }

    .auth-input-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 100%;
        flex-shrink: 0;
        border-right: 1px solid #ddd;
        color: #aaa;
        font-size: 13px;
    }

    .auth-input-group input {
        width: 100%;
        height: 100%;
        padding: 0 10px;
        border: none;
        outline: none;
        box-shadow: none;
        font-size: 13px;
    }

    .auth-input-group:focus-within {
        border-color: #e53935;
    }

        .auth-input-group:focus-within .auth-input-icon {
            color: #e53935;
        }

    .auth-validation {
        margin-bottom: 10px;
        color: #dc2626;
        font-size: 12px;
    }

    .auth-field-error {
        display: block;
        margin: -4px 0 7px;
        color: #dc2626;
        font-size: 11px;
    }

    .auth-submit {
        width: 100%;
        height: 38px;
        margin-top: 2px;
        border: none;
        background: #e53935;
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
    }

        .auth-submit:hover {
            background: #c62828;
        }

    .auth-links {
        margin-top: 10px;
        color: #777;
        font-size: 12px;
    }

        .auth-links a {
            color: #e53935;
            text-decoration: none;
        }

            .auth-links a:hover {
                text-decoration: underline;
            }

    .auth-bottom-link {
        margin-top: 9px;
        font-size: 12px;
        text-align: center;
    }

        .auth-bottom-link a {
            color: #e53935;
            font-weight: 600;
            text-decoration: none;
        }

    @@media(max-width: 600px) {
        .auth-page {
            padding: 15px 10px;
        }

        .auth-panel {
            min-height: 400px;
        }

        .auth-form {
            max-width: 100%;
            padding: 0 10px;
        }
    }
</style>

<div class="auth-page">
    <div class="auth-panel">

        <h2 class="auth-heading">
            <span>ĐĂNG NHẬP</span>
        </h2>

        <div class="auth-form">
            
            @using (Html.BeginForm("Login", "Login", FormMethod.Post))
            {

                @Html.AntiForgeryToken()

                @Html.ValidationSummary(
                    false,
                    "",
                    new { @class = "auth-validation" }
                )

                <div class="auth-input-group">
                    <span class="auth-input-icon">
                        <i class="fa-regular fa-user"></i>
                    </span>

                    @Html.TextBoxFor(m => m.Username, new
                    {
                        placeholder = "Tên tài khoản",
                        autocomplete = "username",
                        maxlength = "255"
                    })
                </div>

                @Html.ValidationMessageFor(
                    m => m.Username,
                    "",
                    new { @class = "auth-field-error" }
                )

                <div class="auth-input-group">
                    <span class="auth-input-icon">
                        <i class="fa-solid fa-lock"></i>
                    </span>

                    @Html.PasswordFor(m => m.Password, new
                    {
                        placeholder = "Mật khẩu",
                        autocomplete = "current-password"
                    })
                </div>

                @Html.ValidationMessageFor(
                    m => m.Password,
                    "",
                    new { @class = "auth-field-error" }
                )

                <button type="submit" class="auth-submit">
                    ĐĂNG NHẬP
                </button>
            }

            <div class="auth-links">
                <a href="@Url.Action("RePass", "Login")">
                    Quên mật khẩu?
                </a>

                hoặc

                <a href="@Url.Action("NewAccount", "Login")">
                    Đăng ký
                </a>
            </div>

            <div class="auth-bottom-link">
                <a href="@Url.Action("Index", "Home")">
                    ← Quay lại trang chủ
                </a>
            </div>

        </div>
        @if (TempData["RegisterSuccess"] != null)
        {
            <div class="alert alert-success">
                @TempData["RegisterSuccess"]
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
