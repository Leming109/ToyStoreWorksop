@model IEnumerable<ToyStoreBE.Models.MyModel.CartItem>
@using System.Linq

@{
    ViewBag.Title = "Giỏ hàng của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int totalQuantity = Model == null ? 0 : Model.Sum(x => x.Quantity);
    int totalItems = Model == null ? 0 : Model.Count();
    decimal totalAmount = Model == null ? 0 : Model.Sum(x => x.TotalPrice);
}

<style>
    .cart-page {
        max-width: 1250px;
        margin: 25px auto 45px;
        padding: 0 20px;
        color: #292929;
    }

    /* HEADER */
    .cart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

        .cart-header h2 {
            margin: 0 0 8px;
            font-size: 27px;
            font-weight: 700;
            color: #222;
        }

        .cart-header p {
            margin: 0;
            color: #777;
            font-size: 14px;
        }

    .cart-count {
        padding: 9px 17px;
        border-radius: 25px;
        background: #fff0ef;
        color: #e53935;
        font-size: 14px;
        font-weight: 700;
    }

    /* THÔNG BÁO */
    .cart-message {
        margin-bottom: 18px;
        padding: 12px 16px;
        border: 1px solid #f5c2c0;
        border-radius: 7px;
        background: #fff5f4;
        color: #c62828;
        font-size: 14px;
    }

    /* DANH SÁCH */
    .cart-content {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 300px;
        align-items: start;
        gap: 22px;
    }

    .cart-products {
        min-width: 0;
    }

    .cart-item {
        display: grid;
        grid-template-columns: 165px minmax(0, 1fr);
        gap: 22px;
        margin-bottom: 17px;
        padding: 20px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 3px 12px rgba(0,0,0,.035);
    }

    /* ẢNH VÀ GHI CHÚ */
    .cart-item-left {
        min-width: 0;
    }

    .cart-image {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 165px;
        padding: 8px;
        overflow: hidden;
        border: 1px solid #eee;
        border-radius: 8px;
        background: #f8f8f8;
    }

        .cart-image img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .cart-note {
        margin-top: 13px;
    }

        .cart-note label {
            display: block;
            margin-bottom: 7px;
            color: #444;
            font-size: 13px;
            font-weight: 600;
        }

        .cart-note textarea {
            display: block;
            width: 100%;
            min-height: 78px;
            padding: 9px;
            border: 1px solid #ddd;
            border-radius: 7px;
            outline: none;
            resize: vertical;
            font-size: 12px;
            line-height: 1.5;
        }

            .cart-note textarea:focus {
                border-color: #e53935;
                box-shadow: 0 0 0 2px rgba(229,57,53,.08);
            }

    /* THÔNG TIN */
    .cart-item-right {
        min-width: 0;
    }

    .cart-item-name {
        margin: 0 0 9px;
        color: #222;
        font-size: 19px;
        font-weight: 700;
        line-height: 1.45;
    }

    .cart-item-category {
        display: inline-block;
        margin-bottom: 13px;
        padding: 5px 11px;
        border-radius: 20px;
        background: #fff0ef;
        color: #e53935;
        font-size: 12px;
        font-weight: 600;
    }

    .cart-unit-price {
        margin-bottom: 15px;
        color: #e53935;
        font-size: 17px;
        font-weight: 700;
    }

        .cart-unit-price small {
            display: block;
            margin-bottom: 4px;
            color: #888;
            font-size: 12px;
            font-weight: 400;
        }

    .cart-item-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 15px;
        padding-top: 15px;
        border-top: 1px solid #eee;
    }

    .cart-quantity label {
        display: block;
        margin-bottom: 7px;
        color: #555;
        font-size: 13px;
        font-weight: 600;
    }

    .cart-quantity input {
        width: 95px;
        height: 38px;
        padding: 0 10px;
        border: 1px solid #ddd;
        border-radius: 6px;
        outline: none;
    }

        .cart-quantity input:focus {
            border-color: #e53935;
        }

    .cart-subtotal {
        color: #333;
        font-size: 14px;
    }

        .cart-subtotal strong {
            display: block;
            margin-top: 5px;
            color: #e53935;
            font-size: 18px;
        }

    .cart-item-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 17px;
    }

    .cart-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 36px;
        padding: 8px 13px;
        border: 1px solid transparent;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none !important;
        transition: .2s;
    }

    .cart-update {
        background: #fff0ef;
        border-color: #f3c3c0;
        color: #d32f2f;
    }

        .cart-update:hover {
            background: #e53935;
            border-color: #e53935;
            color: #fff;
        }

    .cart-remove {
        background: #f8f8f8;
        border-color: #ddd;
        color: #666;
    }

        .cart-remove:hover {
            background: #333;
            border-color: #333;
            color: #fff;
        }

    /* TỔNG TIỀN */
    .cart-summary {
        position: sticky;
        top: 240px;
        padding: 22px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 3px 12px rgba(0,0,0,.035);
    }

        .cart-summary h3 {
            margin: 0 0 19px;
            font-size: 18px;
            font-weight: 700;
        }

    .cart-summary-row {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 13px;
        color: #666;
        font-size: 13px;
    }

        .cart-summary-row strong {
            color: #333;
        }

    .cart-summary-total {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-top: 17px;
        padding-top: 17px;
        border-top: 1px solid #eee;
        font-size: 15px;
        font-weight: 700;
    }

        .cart-summary-total strong {
            color: #e53935;
            font-size: 21px;
        }

    .cart-checkout {
        display: block;
        width: 100%;
        margin-top: 22px;
        padding: 13px;
        border: 0;
        border-radius: 7px;
        background: #e53935;
        color: #fff;
        text-align: center;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none !important;
    }

        .cart-checkout:hover {
            background: #c62828;
            color: #fff;
        }

    .cart-continue {
        display: block;
        margin-top: 12px;
        color: #555;
        text-align: center;
        font-size: 13px;
        text-decoration: none;
    }

        .cart-continue:hover {
            color: #e53935;
        }

    .cart-clear-form {
        margin-top: 13px;
    }

    .cart-clear-button {
        width: 100%;
        padding: 9px;
        border: 1px solid #eee;
        border-radius: 6px;
        background: #fff;
        color: #dc2626;
        font-size: 12px;
        cursor: pointer;
    }

        .cart-clear-button:hover {
            background: #fff1f1;
            border-color: #f3b7b7;
        }

    /* GIỎ HÀNG TRỐNG */
    .cart-empty {
        padding: 65px 20px;
        border: 1px solid #eee;
        border-radius: 12px;
        background: #fff;
        text-align: center;
    }

        .cart-empty i {
            margin-bottom: 17px;
            color: #e5a5a2;
            font-size: 55px;
        }

        .cart-empty h3 {
            margin-bottom: 10px;
            color: #333;
            font-weight: 700;
        }

        .cart-empty p {
            color: #888;
            font-size: 14px;
        }

        .cart-empty a {
            display: inline-block;
            margin-top: 12px;
            padding: 11px 24px;
            border-radius: 7px;
            background: #e53935;
            color: #fff;
            text-decoration: none;
        }

    /* RESPONSIVE */
    @@media(max-width: 900px) {
        .cart-content {
            grid-template-columns: 1fr;
        }

        .cart-summary {
            position: static;
        }
    }

    @@media(max-width: 600px) {
        .cart-page {
            padding: 0 5px;
        }

        .cart-header h2 {
            font-size: 23px;
        }

        .cart-item {
            grid-template-columns: 1fr;
            gap: 16px;
            padding: 13px;
        }

        .cart-image {
            height: 210px;
        }

        .cart-item-name {
            font-size: 17px;
        }

        .cart-item-bottom {
            align-items: flex-start;
        }
    }
</style>

<div class="cart-page">

    <!-- TIÊU ĐỀ GIỎ HÀNG -->
    <div class="cart-header">
        <div>
            <h2>GIỎ HÀNG CỦA BẠN</h2>

            <p>
                Kiểm tra sản phẩm và thông tin trước khi đặt hàng.
            </p>
        </div>

        <div class="cart-count">
            @totalQuantity sản phẩm
        </div>
    </div>

    <!-- THÔNG BÁO -->
    @if (TempData["CartMessage"] != null)
    {
        <div class="cart-message">
            <i class="fa-solid fa-circle-check"></i>
            @TempData["CartMessage"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="cart-content">

            <!-- DANH SÁCH SẢN PHẨM -->
            <div class="cart-products">

                @foreach (var item in Model)
                {
                    <div class="cart-item-form-wrapper">

                        @using (Html.BeginForm(
                            "UpdateItem",
                            "Cart",
                            FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            @Html.Hidden("id", item.ProductID)

                            <div class="cart-item">

                                <!-- ẢNH VÀ GHI CHÚ -->
                                <div class="cart-item-left">

                                    <div class="cart-image">
                                        <img src="@Url.Content(
                                            string.IsNullOrWhiteSpace(item.ProductImage)
                                                ? "~/Content/images/default_img.png"
                                                : item.ProductImage)"
                                             alt="@item.ProductName" />
                                    </div>

                                    <div class="cart-note">
                                        <label for="note_@item.ProductID">
                                            <i class="fa-regular fa-note-sticky"></i>
                                            Ghi chú cho cửa hàng
                                        </label>

                                        <textarea id="note_@item.ProductID"
                                                  name="note"
                                                  maxlength="500"
                                                  placeholder="Nhập ghi chú của bạn...">@item.Note</textarea>
                                    </div>

                                </div>

                                <!-- THÔNG TIN SẢN PHẨM -->
                                <div class="cart-item-right">

                                    <h3 class="cart-item-name">
                                        @item.ProductName
                                    </h3>

                                    <span class="cart-item-category">
                                        <i class="fa-solid fa-tag"></i>
                                        @item.CategoryName
                                    </span>

                                    <div class="cart-unit-price">
                                        <small>Đơn giá</small>
                                        @item.UnitPrice.ToString("N0") VNĐ
                                    </div>

                                    <div class="cart-item-bottom">

                                        <div class="cart-quantity">
                                            <label>Số lượng</label>

                                            <input type="number"
                                                   name="quantity"
                                                   value="@item.Quantity"
                                                   min="1"
                                                   max="99"
                                                   required />
                                        </div>

                                        <div class="cart-subtotal">
                                            Thành tiền

                                            <strong>
                                                @item.TotalPrice.ToString("N0") VNĐ
                                            </strong>
                                        </div>

                                    </div>

                                    <div class="cart-item-actions">

                                        <button type="submit"
                                                class="cart-button cart-update">
                                            <i class="fa-solid fa-rotate"></i>
                                            Cập nhật
                                        </button>

                                        <button type="submit"
                                                formaction="@Url.Action("Remove", "Cart")"
                                                formnovalidate
                                                class="cart-button cart-remove"
                                                onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này khỏi giỏ hàng không?');">
                                            <i class="fa-solid fa-trash"></i>
                                            Xóa sản phẩm
                                        </button>

                                    </div>

                                </div>

                            </div>
                        }
                    </div>
                }

            </div>

            <!-- TỔNG ĐƠN HÀNG -->
            <aside class="cart-summary">

                <h3>Tổng đơn hàng</h3>

                <div class="cart-summary-row">
                    <span>Số mặt hàng</span>
                    <strong>@totalItems</strong>
                </div>

                <div class="cart-summary-row">
                    <span>Tổng số lượng</span>
                    <strong>@totalQuantity</strong>
                </div>

                <div class="cart-summary-total">
                    <span>Tổng tiền</span>

                    <strong>
                        @totalAmount.ToString("N0") VNĐ
                    </strong>
                </div>

                <a href="@Url.Action("Checkout", "Cart")"
                   class="cart-checkout">
                    TIẾN HÀNH ĐẶT HÀNG
                </a>

                <a href="@Url.Action("Index", "Home")"
                   class="cart-continue">
                    <i class="fa-solid fa-arrow-left"></i>
                    Tiếp tục mua sắm
                </a>

                @using (Html.BeginForm("Clear", "Cart", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="cart-clear-button"
                            onclick="return confirm('Bạn có chắc chắn muốn xóa toàn bộ giỏ hàng không?');">
                        Xóa toàn bộ giỏ hàng
                    </button>
                }

            </aside>

        </div>
    }
    else
    {
        <!-- GIỎ HÀNG TRỐNG -->
        <div class="cart-empty">

            <i class="fa-solid fa-cart-shopping"></i>

            <h3>Giỏ hàng của bạn đang trống</h3>

            <p>
                Hãy khám phá các sản phẩm tại ToyStore và thêm vào giỏ hàng nhé!
            </p>

            <a href="@Url.Action("Index", "Home")">
                TIẾP TỤC MUA SẮM
            </a>

        </div>
    }

</div>