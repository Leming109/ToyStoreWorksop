@model ToyStoreBE.Models.Order

@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .order-success-page {
        max-width: 950px;
        margin: 35px auto 50px;
        padding: 0 15px;
    }

    .order-success-card {
        padding: 35px;
        border: 1px solid #eee;
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 5px 20px rgba(0,0,0,.05);
    }

    .order-success-heading {
        padding-bottom: 25px;
        border-bottom: 1px solid #eee;
        text-align: center;
    }

    .order-success-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 65px;
        height: 65px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: #e9f9ef;
        color: #16a34a;
        font-size: 32px;
    }

    .order-success-heading h2 {
        margin-bottom: 9px;
        color: #16a34a;
        font-size: 25px;
        font-weight: 700;
    }

    .order-success-heading p {
        color: #777;
        font-size: 14px;
    }

    .order-success-info {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
        padding: 22px 0;
    }

    .order-info-item {
        padding: 13px;
        border-radius: 7px;
        background: #f8f8f8;
    }

        .order-info-item span {
            display: block;
            margin-bottom: 6px;
            color: #888;
            font-size: 12px;
        }

        .order-info-item strong {
            color: #333;
            font-size: 14px;
        }

    .order-success-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

        .order-success-table th,
        .order-success-table td {
            padding: 13px 10px;
            border-bottom: 1px solid #eee;
            text-align: left;
            font-size: 13px;
        }

        .order-success-table th {
            background: #f7f7f7;
            color: #555;
        }

            .order-success-table td:last-child,
            .order-success-table th:last-child {
                text-align: right;
            }

    .order-final-total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-top: 22px;
        padding-top: 18px;
        border-top: 1px solid #ddd;
        font-size: 16px;
        font-weight: 700;
    }

        .order-final-total strong {
            color: #e53935;
            font-size: 23px;
        }

    .order-success-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 28px;
    }

        .order-success-actions a {
            padding: 12px 22px;
            border-radius: 6px;
            background: #e53935;
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
        }

            .order-success-actions a:hover {
                background: #c62828;
            }

            .order-success-actions a.secondary {
                border: 1px solid #ddd;
                background: #fff;
                color: #555;
            }

    @@media(max-width: 600px) {
        .order-success-card {
            padding: 20px 13px;
        }

        .order-success-info {
            grid-template-columns: 1fr;
        }

        .order-success-table th,
        .order-success-table td {
            padding: 10px 5px;
            font-size: 11px;
        }
    }
</style>

<div class="order-success-page">

    <div class="order-success-card">

        <div class="order-success-heading">

            <div class="order-success-icon">
                <i class="fa-solid fa-check"></i>
            </div>

            <h2>ĐẶT HÀNG THÀNH CÔNG!</h2>

            <p>
                ToyStore đã tiếp nhận đơn hàng của bạn.
                Cảm ơn bạn đã mua sắm tại cửa hàng!
            </p>

        </div>

        <div class="order-success-info">

            <div class="order-info-item">
                <span>Mã đơn hàng</span>
                <strong>#@Model.OrderID</strong>
            </div>

            <div class="order-info-item">
                <span>Ngày đặt hàng</span>
                <strong>@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</strong>
            </div>

            <div class="order-info-item">
                <span>Trạng thái thanh toán</span>
                <strong>COD - Thanh toán khi nhận hàng</strong>
            </div>

            <div class="order-info-item">
                <span>Địa chỉ nhận hàng</span>
                <strong>@Model.AddressDelivery</strong>
            </div>

        </div>

        <h3 style="font-size:17px; font-weight:700; margin:10px 0 15px;">
            Chi tiết đơn hàng
        </h3>

        <div class="table-responsive">

            <table class="order-success-table">

                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Đơn giá</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.OrderDetails)
                    {
                        <tr>
                            <td>
                                @(item.Product != null
                                    ? item.Product.ProductName
                                    : "Sản phẩm")
                            </td>

                            <td>
                                @item.UnitPrice.ToString("N0") VNĐ
                            </td>

                            <td>
                                @item.Quantity
                            </td>

                            <td>
                                @((item.UnitPrice * item.Quantity).ToString("N0")) VNĐ
                            </td>
                            <td>
                                @(item.Note)
                            </td>
                        </tr>

                    }


                </tbody>

            </table>

        </div>

        <div class="order-final-total">
            <span>Tổng tiền đơn hàng</span>

            <strong>
                @Model.TotalAmount.ToString("N0") VNĐ
            </strong>
        </div>

        <div class="order-success-actions">

            <a href="@Url.Action("Index", "Home")">
                Tiếp tục mua sắm
            </a>

            <a class="secondary"
               href="@Url.Action("Index", "Cart")">
                Quay lại giỏ hàng
            </a>

        </div>

    </div>
</div>